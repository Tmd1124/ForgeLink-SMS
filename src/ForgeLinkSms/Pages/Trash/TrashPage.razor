@page "/trash"
@implements IDisposable
@inject ForgeLinkSms.Core.ViewModels.TrashViewModel ViewModel
@inject ForgeLinkSms.Core.Services.NavigationHistoryTracker HistoryTracker
@using ForgeLinkSms.Components

<div style="padding:12px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="margin:0;">Trash</h3>
        @if (ViewModel.TrashedThreads.Count > 0)
        {
            <div style="display:flex;align-items:center;gap:12px;">
                @if (_selectedThreadIds.Count > 0)
                {
                    <span>@_selectedThreadIds.Count selected</span>
                }
                <span @onclick="ToggleSelectAll" style="color:var(--accent-color);cursor:pointer;font-weight:600;">
                    @(AllSelected() ? "Deselect all" : "Select all")
                </span>
            </div>
        }
    </div>

    @if (ViewModel.TrashedThreads.Count > 0)
    {
        <div style="display:flex;gap:8px;margin-bottom:12px;">
            @if (_selectedThreadIds.Count > 0)
            {
                <button @onclick="() => ConfirmDelete(_selectedThreadIds.ToList())" style="@DeleteButtonStyle">🗑 Delete selected (@_selectedThreadIds.Count)</button>
            }
            <button @onclick="() => ConfirmDelete(ViewModel.TrashedThreads.Select(t => t.Id).ToList())" style="@DeleteButtonStyle">🗑 Delete all (@ViewModel.TrashedThreads.Count)</button>
        </div>
    }

    @if (ViewModel.TrashedThreads.Count == 0)
    {
        <p>No trashed conversations.</p>
    }
    else
    {
        @foreach (var thread in ViewModel.TrashedThreads)
        {
            <div style="padding:10px;border-bottom:1px solid #eee;display:flex;align-items:center;gap:10px;">
                <div @onclick="() => ToggleSelection(thread.Id)"
                     style="width:24px;height:24px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:0.9em;background:@(_selectedThreadIds.Contains(thread.Id) ? "var(--accent-color)" : "transparent");border:2px solid var(--accent-color);color:white;cursor:pointer;">
                    @(_selectedThreadIds.Contains(thread.Id) ? "✓" : "")
                </div>
                <div style="flex:1;min-width:0;">
                    <strong>@thread.DisplayNameOrAddress</strong>
                    <div style="color:#94a3b8;font-size:0.85em;">@thread.PreviewText</div>
                </div>
                <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
                    <button @onclick="() => ViewModel.RestoreCommand.ExecuteAsync(thread.Id)"
                            style="border:none;border-radius:8px;padding:6px 12px;background:var(--accent-color);color:white;font-weight:600;">Restore</button>
                    <button @onclick="() => ConfirmDelete(new List<long> { thread.Id })"
                            style="border:none;border-radius:8px;padding:6px 12px;background:#ef4444;color:white;font-weight:600;">Delete</button>
                </div>
            </div>
        }

        <p style="color:#94a3b8;font-size:0.85em;text-align:center;margin-top:16px;">
            Messages will be removed after 30 days.
        </p>
    }
</div>

<ConfirmDeleteDialog @ref="_confirmDialog" OnConfirm="DeletePending" />

@code {
    private const string DeleteButtonStyle = "flex:1;border:none;border-radius:10px;padding:10px;background:#ef4444;color:white;font-weight:600;";

    private readonly HashSet<long> _selectedThreadIds = new();
    private ConfirmDeleteDialog? _confirmDialog;
    private List<long> _pendingDeleteIds = new();

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadCommand.ExecuteAsync(null);
        HistoryTracker.LocalBackHandler = TryCloseOverlayForBack;
    }

    // The hardware back button is fully intercepted at the native layer (see MainActivity), so
    // it no longer reaches this page's own click handlers — it must close the confirm dialog or
    // clear an active selection itself instead of falling through to leaving the page.
    private bool TryCloseOverlayForBack()
    {
        if (_confirmDialog is { IsOpen: true })
        {
            _confirmDialog.Close();
            return true;
        }

        if (_selectedThreadIds.Count == 0)
        {
            return false;
        }

        _selectedThreadIds.Clear();
        StateHasChanged();
        return true;
    }

    public void Dispose()
    {
        if (HistoryTracker.LocalBackHandler == TryCloseOverlayForBack)
        {
            HistoryTracker.LocalBackHandler = null;
        }
    }

    private void ToggleSelection(long threadId)
    {
        if (!_selectedThreadIds.Remove(threadId))
        {
            _selectedThreadIds.Add(threadId);
        }
    }

    private bool AllSelected() =>
        ViewModel.TrashedThreads.Count > 0 &&
        ViewModel.TrashedThreads.All(t => _selectedThreadIds.Contains(t.Id));

    private void ToggleSelectAll()
    {
        if (AllSelected())
        {
            _selectedThreadIds.Clear();
        }
        else
        {
            foreach (var thread in ViewModel.TrashedThreads)
            {
                _selectedThreadIds.Add(thread.Id);
            }
        }
    }

    private void ConfirmDelete(List<long> threadIds)
    {
        _pendingDeleteIds = threadIds;
        _confirmDialog?.Open(threadIds.Count);
    }

    private async Task DeletePending()
    {
        var ids = _pendingDeleteIds;
        _pendingDeleteIds = new();
        _selectedThreadIds.ExceptWith(ids);
        await ViewModel.DeleteThreadsCommand.ExecuteAsync(ids);
    }
}
