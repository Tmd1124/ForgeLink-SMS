@page "/menu"
@inject ForgeLinkSms.Core.ViewModels.MenuViewModel ViewModel
@inject ForgeLinkSms.Core.Services.IProfileService ProfileService
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject ForgeLinkSms.Core.Services.IReviewPromptService ReviewPrompt
@inject ForgeLinkSms.Core.Services.IDisplayStyleService DisplayStyles
@using ForgeLinkSms.Core.Utils

<div style="padding:12px;">
    @{ var profile = ProfileService.GetProfile(); }
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
        <div @onclick="@(() => Nav.NavigateTo("/profile"))"
             style="flex:1;min-width:0;display:flex;align-items:center;gap:12px;padding:12px;background:var(--card-color);border-radius:12px;" role="button" tabindex="0">
            @if (!string.IsNullOrEmpty(_photoDataUri))
            {
                <img src="@_photoDataUri" alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;" />
            }
            else
            {
                <div style="width:56px;height:56px;border-radius:50%;background:#e2e8f0;"></div>
            }
            <strong style="flex:1;">@(string.IsNullOrEmpty(profile.DisplayName) ? "Set up your profile" : profile.DisplayName)</strong>
            <span aria-hidden="true" style="@ChevronStyle">›</span>
        </div>
        <HelpButton />
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <p style="color:#06b6d4;" role="status">@ViewModel.StatusMessage</p>
    }

    <section aria-labelledby="menu-messages">
        <h2 id="menu-messages" style="@HeadingStyle">Messages</h2>
        <div style="@GroupStyle">
            @Row("✓", "Mark all as read", () => ViewModel.MarkAllAsReadCommand.ExecuteAsync(null), opensScreen: false)
            @Row("↩", "Undo last action", () => ViewModel.UndoCommand.ExecuteAsync(null), opensScreen: false)
            @Row("⏰", "Scheduled", () => Go("/scheduled"))
            @Row("🔔", "Reminders", () => Go("/reminders"))
            @Row("↔️", "Scrolling", () => Go("/scrolling"), last: true, summary: SwipeRules.Summary(DisplayStyles.GetDisplaySettings()))
        </div>
    </section>

    <section aria-labelledby="menu-organize">
        <h2 id="menu-organize" style="@HeadingStyle">Organize</h2>
        <div style="@GroupStyle">
            @Row("🏷️", "Filters", () => Go("/filters"))
            @Row("📦", "Archived", () => Go("/archived"))
            @Row("💤", "Snoozed", () => Go("/snoozed"))
            @Row("🚫", "Blocked", () => Go("/blocked"))
            @Row("🗑", "Trash", () => Go("/trash"), last: true)
        </div>
    </section>

    <section aria-labelledby="menu-app">
        <h2 id="menu-app" style="@HeadingStyle">App</h2>
        <div style="@GroupStyle">
            @Row("🎨", "Theme", () => Go("/theme"))
            @Row("⚙", "Settings", () => Go("/settings"))
            @Row("⭐", "Rate ForgeLink on Google Play", () => { ReviewPrompt.OpenStoreListing(); return Task.CompletedTask; }, last: true)
        </div>
    </section>
</div>

@code {
    private const string HeadingStyle = "margin:20px 4px 6px;font-size:0.8em;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#94a3b8;";
    private const string GroupStyle = "background:var(--card-color);border-radius:12px;overflow:hidden;";
    private const string ChevronStyle = "color:#94a3b8;font-size:1.3em;line-height:1;";

    private string? _photoDataUri;

    protected override async Task OnInitializedAsync()
    {
        _photoDataUri = await ProfileService.GetProfilePhotoDataUriAsync();
    }

    private Task Go(string route)
    {
        Nav.NavigateTo(route);
        return Task.CompletedTask;
    }

    private RenderFragment Row(string icon, string label, Func<Task> onClick, bool last = false, bool opensScreen = true, string? summary = null) =>
        @<div @onclick="onClick" role="button" tabindex="0"
              style="display:flex;align-items:center;gap:12px;padding:14px 12px;@(last ? "" : "border-bottom:1px solid rgba(127,127,127,0.2);")">
            <span aria-hidden="true" style="width:1.5em;text-align:center;">@icon</span>
            <span style="flex:1;min-width:0;"><span style="display:block;">@label</span>@if (summary is not null) { <span style="display:block;color:#94a3b8;font-size:0.85em;">@summary</span> }</span>
            @if (opensScreen)
            {
                <span aria-hidden="true" style="@ChevronStyle">›</span>
            }
        </div>;
}
