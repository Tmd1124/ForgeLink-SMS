@page "/menu"
@inject ForgeLinkSms.Core.ViewModels.MenuViewModel ViewModel
@inject ForgeLinkSms.Core.Services.IProfileService ProfileService
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject ForgeLinkSms.Core.Services.IReviewPromptService ReviewPrompt

<div style="padding:12px;">
    @{ var profile = ProfileService.GetProfile(); }
    <div @onclick="@(() => Nav.NavigateTo("/profile"))"
         style="display:flex;align-items:center;gap:12px;padding:12px;background:var(--card-color);border-radius:12px;margin-bottom:12px;" role="button" tabindex="0">
        @if (!string.IsNullOrEmpty(_photoDataUri))
        {
            <img src="@_photoDataUri" alt="" style="width:56px;height:56px;border-radius:50%;object-fit:cover;" />
        }
        else
        {
            <div style="width:56px;height:56px;border-radius:50%;background:#e2e8f0;"></div>
        }
        <strong>@(string.IsNullOrEmpty(profile.DisplayName) ? "Set up your profile" : profile.DisplayName)</strong>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
    {
        <p style="color:#06b6d4;">@ViewModel.StatusMessage</p>
    }

    <div @onclick="@(() => Nav.NavigateTo("/theme"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">🎨</span> Theme
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/profile"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">👤</span> Your Profile
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/trash"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">🗑</span> Trash
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/archived"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">📦</span> Archived
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/snoozed"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">💤</span> Snoozed
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/blocked"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">🚫</span> Blocked
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/filters"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">🏷️</span> Filters
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/scheduled"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">⏰</span> Scheduled
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/reminders"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">🔔</span> Reminders
    </div>
    <div @onclick="() => ViewModel.MarkAllAsReadCommand.ExecuteAsync(null)" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">✓</span> Mark as Read
    </div>
    <div @onclick="() => ViewModel.UndoCommand.ExecuteAsync(null)" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">↩</span> Undo
    </div>
    <div @onclick="@(() => Nav.NavigateTo("/settings"))" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">⚙</span> Settings
    </div>
    <div @onclick="ReviewPrompt.OpenStoreListing" style="padding:12px 0;border-bottom:1px solid #eee;" role="button" tabindex="0">
        <span aria-hidden="true">⭐</span> Rate ForgeLink on Google Play
    </div>
</div>

@code {
    private string? _photoDataUri;

    protected override async Task OnInitializedAsync()
    {
        _photoDataUri = await ProfileService.GetProfilePhotoDataUriAsync();
    }
}
