@page "/assistant"
@inject ForgeLinkSms.Core.Services.AssistantService Assistant
@inject ForgeLinkSms.Core.Services.ICrashReportService Email
@inject IJSRuntime JS
@using ForgeLinkSms.Core.Services

<div class="assist-page">
    <div class="page-title-row">
        <h3>Ask ForgeLink</h3>
    </div>
    <p class="assist-note">Ask how something works or why something isn't working. Please don't type private information. Your messages and contacts are never sent.</p>
    <p class="assist-note">While Googling is on, a question that isn't about ForgeLink is sent to a web search service (Tavily) to find pages, and Google's Gemini writes the answer from them. The pages it used are listed under the answer. Turn Googling off to keep every question on the ForgeLink help pages.</p>

    <div class="assist-thread" role="log" aria-live="polite">
        <div class="assist-bubble bot">Hi! Ask me how anything in ForgeLink works.</div>
        @foreach (var message in _messages)
        {
            <div class="assist-bubble @(message.FromMe ? "me" : "bot")">@message.Text</div>
            @if (message.Source is { Length: > 0 } source)
            {
                <div class="assist-source">@source</div>
            }
            @if (message.Links is { Count: > 0 } links)
            {
                <div class="assist-links">
                    @foreach (var link in links)
                    {
                        var target = link;
                        <button class="assist-link" @onclick="() => OpenLink(target)">↗ @target.Title</button>
                    }
                </div>
            }
        }
        @if (_thinking)
        {
            <div class="assist-bubble bot assist-thinking" aria-label="Thinking">…</div>
        }
        <div id="assist-end"></div>
    </div>

    @if (_messages.Count == 0)
    {
        <div class="assist-chips">
            @foreach (var suggestion in Suggestions)
            {
                var text = suggestion;
                <button class="assist-chip" @onclick="() => Ask(text)">@text</button>
            }
        </div>
    }
    else
    {
        <button class="assist-report" @onclick="Email.EmailFeedback">Send a report</button>
    }

    <button type="button" class="assist-web @(_web ? "on" : "")" role="switch" aria-checked="@(_web ? "true" : "false")" @onclick="ToggleGoogling">
        🌐 Googling: @(_web ? "on" : "off")
    </button>

    <form class="assist-input" @onsubmit="() => Ask(_draft)" @onsubmit:preventDefault>
        <input @bind="_draft" @bind:event="oninput" maxlength="500" placeholder="Ask a question" aria-label="Ask a question" autocomplete="off" />
        <button type="submit" disabled="@(_thinking || string.IsNullOrWhiteSpace(_draft))" aria-label="Send">➤</button>
    </form>
</div>

@code {
    private static readonly string[] Suggestions =
    {
        "How do I pin a chat?",
        "How do I back up my texts?",
        "What do the Updates and Screener tabs do?"
    };

    private sealed record Message(string Text, bool FromMe, string? Source = null, IReadOnlyList<AssistantLink>? Links = null);

    private readonly List<Message> _messages = new();
    private string _draft = string.Empty;
    private bool _thinking;
    private const string GooglingKey = "assistant_googling";
    private bool _web = Preferences.Get(GooglingKey, true);

    private async Task Ask(string question)
    {
        question = question.Trim();
        if (question.Length < 2 || _thinking)
        {
            return;
        }
        _draft = string.Empty;
        _messages.Add(new Message(question, true));
        _thinking = true;
        await ScrollToEnd();
        try
        {
            var reply = await Assistant.AskAsync(question, _web);
            _messages.Add(new Message(reply.Text, false, SourceLabel(reply), reply.Sources));
        }
        finally
        {
            _thinking = false;
        }
        await ScrollToEnd();
    }

    private static string? SourceLabel(AssistantReply reply) => reply.Source switch
    {
        AssistantSource.Cloud => $"From Help: {reply.Topic}",
        AssistantSource.Web => "Googled it. AI can make mistakes, so check the pages it used.",
        AssistantSource.Offline => "Answered from the help pages while the assistant is unavailable",
        _ => null
    };

    private void ToggleGoogling()
    {
        _web = !_web;
        Preferences.Set(GooglingKey, _web);
    }

    private static Task OpenLink(AssistantLink link) => Launcher.Default.OpenAsync(new Uri(link.Url));

    private async Task ScrollToEnd()
    {
        StateHasChanged();
        await JS.InvokeVoidAsync("forgeLinkScroll.intoView", "assist-end");
    }
}
