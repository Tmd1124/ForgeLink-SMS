    private async Task JumpToResult(ForgeLinkSms.Core.Models.SmsMessage result)
    {
        await CloseSearch();
        await JumpToMessage(result);
    }

    private async Task JumpToMessage(ForgeLinkSms.Core.Models.SmsMessage result)
    {
        _ignoreNewestEdgeUntilUtc = DateTime.UtcNow.AddSeconds(2);
        await ViewModel!.JumpToCommand.ExecuteAsync(result);
        _scrollToMessageId = MessageDomId(result);

        // Fade the highlight after a moment so it points the message out without lingering.
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                ViewModel.HighlightedMessage = null;
                StateHasChanged();
            });
        });
    }

    // "❤️👍" or "❤️2" when the same reaction came more than once (e.g. in a group).
    private static string ReactionSummary(ForgeLinkSms.Core.Models.SmsMessage message) =>
        string.Concat(message.Reactions.GroupBy(r => r).Select(g => g.Count() > 1 ? $"{g.Key}{g.Count()}" : g.Key));

    private static string MessageDomId(ForgeLinkSms.Core.Models.SmsMessage message) => $"msg-{message.Id}-{message.Timestamp.Ticks}";

    private bool IsHighlighted(ForgeLinkSms.Core.Models.SmsMessage message) =>
        ViewModel?.HighlightedMessage is { } highlighted && highlighted.Id == message.Id && highlighted.Timestamp == message.Timestamp;

    // Up to ~30 characters before the match and ~50 after, so the match is visible in one line.
    private static (string Before, string Match, string After) Snippet(string body, string query)
    {
        var index = body.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
        {
            return (body.Length > 80 ? body[..80] + "…" : body, string.Empty, string.Empty);
        }
        var start = Math.Max(0, index - 30);
        var afterStart = index + query.Length;
        var afterEnd = Math.Min(body.Length, afterStart + 50);
        return (
            (start > 0 ? "…" : string.Empty) + body[start..index],
            body.Substring(index, query.Length),
            body[afterStart..afterEnd] + (afterEnd < body.Length ? "…" : string.Empty));
    }

    private static string FormatResultDate(DateTimeOffset timestamp)
    {
        var local = timestamp.LocalDateTime;
        if (local.Date == DateTime.Today)
        {
            return local.ToString("h:mm tt");
        }
        return local.Year == DateTime.Today.Year ? local.ToString("MMM d") : local.ToString("MMM d, yyyy");
    }

    [Microsoft.JSInterop.JSInvokable]
    public void OnHorizontalSwipe(double dx, double dy, double elapsedMs)
    {
        if (!BackSwipe.IsBackSwipe(dx, dy, elapsedMs))
        {
            return;
        }
        if (!HistoryTracker.TryConsumeLocalBack() && !HistoryTracker.TryGoBack())
        {
            Services.GetRequiredService<NavigationManager>().NavigateTo("/conversations");
        }
        StateHasChanged();
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnScrolledNearOldestMessage()
    {
        if (ViewModel is not null)
        {
            // Unlike a Blazor-bound event handler (@onclick, @onscroll), a [JSInvokable] method
            // reached via raw JS interop doesn't automatically trigger a re-render when it
            // completes — the ViewModel's Messages collection was genuinely growing on every
            // scroll, but the page never repainted to show it, so it looked permanently stuck
            // at the first page.
            await ViewModel.LoadOlderMessagesCommand.ExecuteAsync(null);
            StateHasChanged();
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnScrolledNearNewestMessage()
    {
        // Right after a search jump the swapped-in history briefly sits at the bottom edge,
        // which would otherwise keep fetching newer pages until it caught back up to "now".
        if (DateTime.UtcNow < _ignoreNewestEdgeUntilUtc)
        {
            return;
        }

        if (ViewModel is not null)
        {
            await ViewModel.LoadNewerMessagesCommand.ExecuteAsync(null);
            StateHasChanged();
        }
    }

    // The hardware back button is fully intercepted at the native layer (see MainActivity) to fix
    // an unrelated bug, so it no longer reaches these overlays' own click-outside-to-close handlers —
    // they must be closed here instead of falling through to leaving the thread.
    private bool TryCloseOverlayForBack()
    {
        if (_isSearchOpen)
        {
            _ = CloseSearch();
            StateHasChanged();
            return true;
        }

        if (_viewerAttachment is not null)
        {
            CloseImageViewer();
            return true;
        }

        if (_drawer is { IsOpen: true })
        {
            _drawer.Close();
            return true;
        }

        if (_reactionTargetMessage is not null)
        {
            CloseReactionBar();
            StateHasChanged();
            return true;
        }

        return false;
    }

    public void Dispose()
    {
        Playback.PlaybackChanged -= OnPlaybackChanged;
        Playback.Stop();
        if (_isRecording)
        {
            _recordingTickCts?.Cancel();
            Recorder.Cancel();
        }

        // Leaving the thread shouldn't silently drop a text that's still in its undo window.
        ViewModel?.FlushPendingSend();
        _draftSaveCts?.Cancel();
        _ = ViewModel?.SaveDraftAsync();

        IncomingMessageNotifier.MessageReceived -= OnMessageReceived;

        // Blazor's router can create the next page before disposing this one, so only clear the
        // handler if it's still ours — otherwise this would wipe out a registration the next page
        // already made.
        if (HistoryTracker.LocalBackHandler == TryCloseOverlayForBack)
        {
            HistoryTracker.LocalBackHandler = null;
        }

        _saveToastCts?.Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("forgeLinkInfiniteScroll.dispose", "thread-scroll-container");
            await JS.InvokeVoidAsync("forgeLinkBackSwipe.detach", _backSwipeOwner);
        }
        catch (Exception)
        {
            // The WebView/circuit may already be tearing down by the time this runs — nothing
            // to clean up on the JS side in that case.
        }

        _dotNetRef?.Dispose();
    }

    private IEnumerable<(ForgeLinkSms.Core.Models.SmsMessage Message, bool ShowDateSeparator)> MessagesWithDateSeparators()
    {
        DateOnly? lastDate = null;
        // Reaction texts already shown as a badge on their message aren't rendered on their own.
        foreach (var message in ViewModel!.Messages.Where(m => !m.IsHiddenReaction))
        {
            var date = DateOnly.FromDateTime(message.Timestamp.LocalDateTime);
            yield return (message, date != lastDate);
            lastDate = date;
        }
    }

    private static string FormatDateSeparator(DateTimeOffset timestamp)
    {
        // Android occasionally loses an MMS's date/date_sent entirely (both columns read back as
        // 0, i.e. the Unix epoch) — confirmed on a real device against a genuinely sent photo
        // whose timestamp metadata never got written. The message itself is real content and
        // still gets shown; it just can't carry a meaningful date, so show that plainly instead
        // of the misleading "December 31, 1969" a literal epoch timestamp would format to.
        if (timestamp == DateTimeOffset.UnixEpoch)
        {
            return "Unknown date";
        }

        var date = DateOnly.FromDateTime(timestamp.LocalDateTime);
        var today = DateOnly.FromDateTime(DateTime.Now);
        if (date == today)
        {
            return "Today";
        }
        if (date == today.AddDays(-1))
        {
            return "Yesterday";
        }
        return date.ToString("MMMM d, yyyy");
    }

    private void OnMessagePointerDown(ForgeLinkSms.Core.Models.SmsMessage message)
    {
        _messageLongPressCts = new CancellationTokenSource();
        var token = _messageLongPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                await InvokeAsync(() =>
                {
                    _reactionTargetMessage = message;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelMessageLongPress() => _messageLongPressCts?.Cancel();

