    private async Task ForwardTargetMessage()
    {
        if (_reactionTargetMessage is not { } message)
        {
            return;
        }
        CloseReactionBar();

        ForgeLinkSms.Core.Models.PickedAttachment? attachment = null;
        if (message.Attachments.FirstOrDefault() is { } source)
        {
            attachment = await Services.GetRequiredService<IAttachmentSaveService>().CopyForSendingAsync(source);
        }
        var nav = Services.GetRequiredService<NavigationManager>();
        Services.GetRequiredService<ForwardRequestStore>().Set(new ForwardRequest(
            string.IsNullOrEmpty(message.Body) ? null : message.Body,
            attachment,
            "/" + nav.ToBaseRelativePath(nav.Uri),
            ThreadId,
            ForwardedMessage.KeyFor(message)));
        nav.NavigateTo("/compose");
    }

