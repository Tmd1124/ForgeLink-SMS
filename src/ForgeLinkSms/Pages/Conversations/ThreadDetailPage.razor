    // Saves the draft shortly after typing pauses, so the conversation list already shows it
    // when the user goes back (the list can load before this page finishes disposing).
    private void SaveDraftSoon()
    {
        _draftSaveCts?.Cancel();
        _draftSaveCts = new CancellationTokenSource();
        var token = _draftSaveCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                await ViewModel!.SaveDraftAsync();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private void OnPlaybackChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleVoicePlayback(ForgeLinkSms.Core.Models.MessageAttachment attachment)
    {
        if (Playback.PlayingPartId == attachment.PartId)
        {
            Playback.Stop();
        }
        else
        {
            Playback.Play(attachment.PartId);
        }
    }

    private async Task StartRecording()
    {
        Playback.Stop();
        if (!await Recorder.StartAsync())
        {
            ShowSaveToast("Allow microphone access to record voice messages");
            return;
        }

        _isRecording = true;
        _recordingStartedUtc = DateTime.UtcNow;
        _recordingTickCts = new CancellationTokenSource();
        var token = _recordingTickCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
                while (await timer.WaitForNextTickAsync(token))
                {
                    if (DateTime.UtcNow - _recordingStartedUtc >= VoiceNote.MaxDuration)
                    {
                        await InvokeAsync(SendRecording);
                        return;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private async Task SendRecording()
    {
        if (!_isRecording)
        {
            return;
        }
        _isRecording = false;
        _recordingTickCts?.Cancel();

        var recording = await Recorder.StopAsync();
        if (recording is null)
        {
            ShowSaveToast("Too short to send");
            return;
        }
        await ViewModel!.SendCommand.ExecuteAsync(recording);
    }

    private void CancelRecording()
    {
        _isRecording = false;
        _recordingTickCts?.Cancel();
        Recorder.Cancel();
    }

