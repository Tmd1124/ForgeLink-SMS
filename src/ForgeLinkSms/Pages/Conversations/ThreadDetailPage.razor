    private async Task SendOrSchedule()
    {
        if (_pendingAttachment is not null)
        {
            // Scheduling an MMS send isn't supported — an attachment always sends immediately,
            // same as tapping send normally would.
            var attachment = _pendingAttachment;
            _pendingAttachment = null;
            await ViewModel!.SendCommand.ExecuteAsync(attachment);
        }
        else if (_scheduledSendTime is { } sendAt)
        {
            await ViewModel!.ScheduleSendCommand.ExecuteAsync(sendAt);
            _scheduledSendTime = null;
        }
        else
        {
            await ViewModel!.SendCommand.ExecuteAsync(null);
        }
    }

    private void UndoSend()
    {
        var attachment = ViewModel!.UndoSend();
        if (attachment is not null)
        {
            _pendingAttachment = attachment;
        }
    }

    private void InsertIntoCompose(string text)
    {
        ViewModel!.ComposeText = string.IsNullOrEmpty(ViewModel.ComposeText) ? text : $"{ViewModel.ComposeText}\n{text}";
    }

    protected override async Task OnInitializedAsync()
    {
        DisplayName = Address;
        _forwardedTo = await Services.GetRequiredService<ForgeLinkSms.Core.Data.IForwardedMessageRepository>().GetForThreadAsync(ThreadId);
        _contactService = Services.GetRequiredService<IContactService>();
        var contact = await _contactService.LookupAsync(Address);
        if (contact is not null)
        {
            DisplayName = contact.DisplayName;
            _isKnownContact = true;
        }

        var participants = await Services.GetRequiredService<IThreadService>().GetParticipantsAsync(ThreadId);
        if (participants.Count > 1)
        {
            foreach (var participant in participants)
            {
                var member = await _contactService.LookupAsync(participant);
                _memberNames[PhoneNumberFormatter.ToComparableDigits(participant)] = member?.DisplayName ?? PhoneNumberFormatter.ToDisplayFormat(participant);
            }
            DisplayName = GroupNames.Format(participants.Select(p => _memberNames[PhoneNumberFormatter.ToComparableDigits(p)]).ToList());
        }

        var smsService = Services.GetRequiredService<ISmsService>();
        var scheduler = Services.GetRequiredService<IMessageSchedulerService>();
        ViewModel = new ThreadDetailViewModel(smsService, scheduler, ThreadId, Address, participants: participants,
            drafts: Services.GetRequiredService<ForgeLinkSms.Core.Data.IDraftRepository>(),
            reviewPrompt: Services.GetRequiredService<ForgeLinkSms.Core.Services.IReviewPromptService>());
        await ViewModel.LoadCommand.ExecuteAsync(null);
        if (JumpId is long jumpId && JumpTicks is long jumpTicks)
        {
            await JumpToMessage(new ForgeLinkSms.Core.Models.SmsMessage
            {
                Id = jumpId,
                ThreadId = ThreadId,
                Address = Address,
                Body = string.Empty,
                Timestamp = new DateTimeOffset(jumpTicks, TimeSpan.Zero),
                IsOutgoing = false,
                Status = ForgeLinkSms.Core.Models.SmsMessageStatus.Delivered
            });
        }

        // Fire-and-forget: flipping the read flag is best-effort housekeeping, not something the
        // thread's messages should ever wait on to render — Blazor doesn't paint the updated
        // Messages collection until this whole method returns, so awaiting this here previously
        // meant a slow or failing "mark as read" call blocked the messages from ever showing.
        _ = MarkThreadAsReadBestEffortAsync();

        IncomingMessageNotifier.MessageReceived += OnMessageReceived;
        Playback.PlaybackChanged += OnPlaybackChanged;
        HistoryTracker.LocalBackHandler = TryCloseOverlayForBack;
    }

    // Raised from the SMS receiver's background thread, hence InvokeAsync.
    private void OnMessageReceived(long threadId)
    {
        if (threadId != ThreadId || ViewModel is null)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await ViewModel.RefreshLatestCommand.ExecuteAsync(null);
            StateHasChanged();
            await MarkThreadAsReadBestEffortAsync();
        });
    }

    private async Task MarkThreadAsReadBestEffortAsync()
    {
        try
        {
            await Services.GetRequiredService<IMarkAsReadService>().MarkThreadAsReadAsync(ThreadId);
        }
        catch (Exception)
        {
            // Best-effort — a failure here shouldn't affect anything the user can see.
        }
    }

    // The scroll container itself never gets removed/re-added across re-renders (unlike its
    // children), so the listener only needs attaching once.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("forgeLinkInfiniteScroll.observe", "thread-scroll-container", _dotNetRef);
            await JS.InvokeVoidAsync("forgeLinkBackSwipe.attach", _backSwipeOwner, _dotNetRef);
        }
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchInput.FocusAsync();
        }
        if (_scrollToMessageId is { } messageId)
        {
            _scrollToMessageId = null;
            await JS.InvokeVoidAsync("forgeLinkScrollIntoView", messageId);
        }
    }

