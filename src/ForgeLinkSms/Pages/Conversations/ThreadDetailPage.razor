        _memberNames.TryGetValue(PhoneNumberFormatter.ToComparableDigits(address), out var name) ? name : PhoneNumberFormatter.ToDisplayFormat(address);

    private async Task OpenContact()
    {
        if (ViewModel is { IsGroup: true })
        {
            return;
        }
        if (_contactService is not null)
        {
            await _contactService.OpenContactAsync(Address);
        }
    }

    private void OpenImageViewer(ForgeLinkSms.Core.Models.MessageAttachment attachment) => _viewerAttachment = attachment;

    private void CloseImageViewer() => _viewerAttachment = null;

    private async Task SaveAttachment(ForgeLinkSms.Core.Models.MessageAttachment attachment)
    {
        var saved = await Services.GetRequiredService<IAttachmentSaveService>().SaveToDeviceAsync(attachment);
        if (saved)
        {
            _savedAttachmentPartIds.Add(attachment.PartId);
        }
        ShowSaveToast(saved ? "Saved" : "Couldn't save attachment");
    }

    private void ShowSaveToast(string message)
    {
        _saveToastCts?.Cancel();
        _saveToastCts = new CancellationTokenSource();
        var token = _saveToastCts.Token;
        _saveToastMessage = message;
        _showSaveToast = true;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2000, token);
                await InvokeAsync(() =>
                {
                    _showSaveToast = false;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // A newer save/toast superseded this one, or the page is disposing — either way
                // nothing left to dismiss.
            }
        });
    }

