        UpdateCategory.Codes => "Codes",
        UpdateCategory.Appointments => "Appointments",
        UpdateCategory.Deliveries => "Deliveries",
        UpdateCategory.Banking => "Banking",
        UpdateCategory.Promotions => "Promotions",
        _ => "Other"
    };

