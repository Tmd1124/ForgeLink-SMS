    private async Task OpenMessageResult(ForgeLinkSms.Core.Models.SmsMessage result)
    {
        if (await TryAddToActiveFilters(result.ThreadId))
        {
            return;
        }
        var thread = ViewModel.Threads.FirstOrDefault(t => t.Id == result.ThreadId);
        var address = thread?.Address ?? result.Address;
        Nav.NavigateTo($"/conversations/thread?id={result.ThreadId}&address={Uri.EscapeDataString(address)}&jumpId={result.Id}&jumpTicks={result.Timestamp.UtcTicks}");
    }

    // Up to ~30 characters before the match and ~50 after, so the match is visible in one line.
    private static (string Before, string Match, string After) Snippet(string body, string query)
    {
        var index = body.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
        {
            return (body.Length > 80 ? body[..80] + "…" : body, string.Empty, string.Empty);
        }
        var start = Math.Max(0, index - 30);
        var afterStart = index + query.Length;
        var afterEnd = Math.Min(body.Length, afterStart + 50);
        return (
            (start > 0 ? "…" : string.Empty) + body[start..index],
            body.Substring(index, query.Length),
            body[afterStart..afterEnd] + (afterEnd < body.Length ? "…" : string.Empty));
    }

    private static string FormatResultDate(DateTimeOffset timestamp)
    {
        var local = timestamp.LocalDateTime;
        if (local.Date == DateTime.Today)
        {
            return local.ToString("h:mm tt");
        }
        return local.Year == DateTime.Today.Year ? local.ToString("MMM d") : local.ToString("MMM d, yyyy");
    }

    private void SelectFromPond(SmsThread thread) => StartSelection(thread.Id);

    // The long-pressed chat leads the selection list; later taps just add to the selection.
    private void StartSelection(long threadId)
    {
        if (_selectedThreadIds.Count == 0)
        {
            _pinnedThreadId = threadId;
            _scrollPinnedToTop = true;
        }
        _selectedThreadIds.Add(threadId);
    }

    private IEnumerable<(ConversationLane Lane, string Label, int Count)> LaneTabs()
    {
        yield return (ConversationLane.Conversations, "Chats", 0);
        yield return (ConversationLane.Updates, "Updates", ViewModel.UpdatesCount);
        yield return (ConversationLane.Screener, "Screener", ViewModel.ScreenerCount);
    }

    // The Updates lane shows one header row per topic with its threads underneath only when
    // expanded; every other lane (and any search) is the plain thread list.
    private IEnumerable<((UpdateCategory Category, IReadOnlyList<SmsThread> Threads)? Group, SmsThread? Thread)> VisibleRows()
    {
        if (ViewModel.Lane != ConversationLane.Updates || !string.IsNullOrWhiteSpace(ViewModel.SearchText))
        {
            // While selecting, the bubbles hide, so every thread (bubbled ones included) must be in the list.
            var rows = _selectedThreadIds.Count == 0 ? ViewModel.ListThreads : SelectionOrder.PinFirst(ViewModel.Threads, _pinnedThreadId);
            foreach (var thread in rows)
            {
                yield return (null, thread);
            }
            yield break;
        }

        var pinned = _selectedThreadIds.Count > 0 ? ViewModel.Threads.FirstOrDefault(t => t.Id == _pinnedThreadId) : null;
        if (pinned is not null)
        {
            yield return (null, pinned);
        }
        foreach (var group in ViewModel.UpdateGroups)
        {
            yield return (group, null);
            if (_expandedUpdateGroups.Contains(group.Category))
            {
                foreach (var thread in group.Threads.Where(t => t.Id != pinned?.Id))
                {
                    yield return (null, thread);
                }
            }
        }
    }

    private void ToggleUpdateGroup(UpdateCategory category)
    {
        if (!_expandedUpdateGroups.Remove(category))
        {
            _expandedUpdateGroups.Add(category);
        }
    }

    private static string CategoryIcon(UpdateCategory category) => category switch
