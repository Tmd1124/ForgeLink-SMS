    private Task SnoozeUntilCustom() => _customSnoozeTime is { } until ? SnoozeUntil(until) : Task.CompletedTask;

    private static string FormatSnoozeTime(DateTime local)
    {
        if (local.Date == DateTime.Today)
        {
            return local.ToString("h:mm tt");
        }
        if (local.Date == DateTime.Today.AddDays(1))
        {
            return $"Tomorrow {local:h:mm tt}";
        }
        return local.ToString("ddd h:mm tt");
    }

