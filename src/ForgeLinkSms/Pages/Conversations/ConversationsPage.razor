    private void OpenThread(long threadId, string address)
    {
        Nav.NavigateTo($"/conversations/thread?id={threadId}&address={Uri.EscapeDataString(address)}");
    }

    private void OnPointerDown(long threadId, PointerEventArgs e)
    {
        _activePointerDownThreadId = threadId;
        _pointerDownX = e.ClientX;
        _longPressTriggered = false;
        _longPressCts = new CancellationTokenSource();
        var token = _longPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                _longPressTriggered = true;
                await InvokeAsync(() =>
                {
                    StartSelection(threadId);
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelLongPress() => _longPressCts?.Cancel();

    private void OnPointerMove(PointerEventArgs e)
    {
        if (Math.Abs(e.ClientX - _pointerDownX) > 15)
        {
            CancelLongPress();
        }
    }

    private async Task OnPointerUp(long threadId, string address, PointerEventArgs e)
    {
        _longPressCts?.Cancel();
        if (_activePointerDownThreadId != threadId)
        {
            // pointerup with no matching pointerdown on this row (e.g. an overlay above it just closed
            // mid-gesture and the browser redelivered the release here) — not a real tap, ignore it.
            return;
        }
        _activePointerDownThreadId = null;
        if (_longPressTriggered)
        {
            return;
        }

        if (_selectedThreadIds.Count > 0)
        {
            // Already in selection mode: any tap toggles that row's checkbox instead of
            // opening the thread or triggering a swipe action.
            if (!_selectedThreadIds.Remove(threadId))
            {
                _selectedThreadIds.Add(threadId);
            }
            return;
        }

        var deltaX = e.ClientX - _pointerDownX;
        if (deltaX >= SwipeThreshold)
        {
            await ViewModel.TrashThreadCommand.ExecuteAsync(threadId);
            ShowUndoToast("Deleted");
            return;
        }
        if (deltaX <= -SwipeThreshold)
        {
            await ViewModel.ArchiveThreadCommand.ExecuteAsync(threadId);
            ShowUndoToast("Archived");
            return;
        }

        if (await TryAddToActiveFilters(threadId))
        {
            return;
        }
        OpenThread(threadId, address);
    }

    // While searching with a filter active, tapping something outside the filter adds it;
    // tapping something already in the filter opens it as usual.
    private async Task<bool> TryAddToActiveFilters(long threadId)
    {
        var thread = ViewModel.FindThread(threadId);
        if (!ViewModel.IsAddingToFilter || thread is null || ViewModel.IsInActiveFilters(thread))
        {
            return false;
        }
        await ViewModel.AddToActiveFiltersAsync(threadId);
        ShowInfoToast($"Added {thread.DisplayNameOrAddress} to {ActiveFilterNames()}");
        return true;
    }

    private bool ResultInActiveFilters(ForgeLinkSms.Core.Models.SmsMessage result) =>
        ViewModel.FindThread(result.ThreadId) is { } thread && ViewModel.IsInActiveFilters(thread);

    private string ActiveFilterNames() =>
        string.Join(", ", ViewModel.Filters.Where(f => ViewModel.ActiveFilterIds.Contains(f.Id)).Select(f => f.Name));

    private string? _infoToast;
    private CancellationTokenSource? _infoToastCts;

    private void ShowInfoToast(string message)
    {
        _infoToastCts?.Cancel();
        _infoToastCts = new CancellationTokenSource();
        var token = _infoToastCts.Token;
        _infoToast = message;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2500, token);
                await InvokeAsync(() =>
                {
                    _infoToast = null;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private void ShowUndoToast(string message)
    {
        _undoToastCts?.Cancel();
        _undoToastCts = new CancellationTokenSource();
        var token = _undoToastCts.Token;
        _undoToastMessage = message;
        _showUndoToast = true;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(5000, token);
                await InvokeAsync(() =>
                {
                    _showUndoToast = false;
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // dismissed by Undo or an outside click before the timeout elapsed
            }
        });
    }

    private void DismissUndoToast()
    {
        _undoToastCts?.Cancel();
        _showUndoToast = false;
    }

    private async Task UndoLastSwipeAction()
    {
        _undoToastCts?.Cancel();
        _showUndoToast = false;
        await ViewModel.UndoCommand.ExecuteAsync(null);
    }

