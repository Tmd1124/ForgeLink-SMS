    private string RowBackground(ForgeLinkSms.Core.Models.SmsThread thread)
    {
        if (_selectedThreadIds.Contains(thread.Id))
        {
            return "rgba(99,102,241,0.2)";
        }
        if (TwoPane && thread.Id == _openThreadId)
        {
            return "rgba(99,102,241,0.28)";
        }
        // A speech-bubble card tinted per the Display settings (person, filter or unread color).
        var color = ViewModel.RowColor(thread);
        if (color is null)
        {
            return "var(--card-color)";
        }
        var tint = thread.UnreadCount > 0 ? 45 : 18;
        return $"color-mix(in srgb, {color} {tint}%, var(--card-color))";
    }

    protected override async Task OnInitializedAsync()
    {
        _photoDataUri = await ProfileService.GetProfilePhotoDataUriAsync();
        ViewModel.Display = DisplayStyles.GetDisplaySettings();
        await ViewModel.LoadCommand.ExecuteAsync(null);
        _isLoading = false;
        // Blazor can dispose a page while it is still loading; subscribing after that would leak it.
        if (_disposed)
        {
            return;
        }
        AppResumeNotifier.Resumed += OnAppResumed;
        IncomingMessageNotifier.MessageReceived += OnMessageReceived;
        if (TwoPane)
        {
            HistoryTracker.PaneBackHandler = TryCloseOverlayForBack;
            _openThreadId = ForgeLinkSms.Core.Utils.TwoPaneRules.OpenThreadId(Nav.ToBaseRelativePath(Nav.Uri));
            Nav.LocationChanged += OnListLocationChanged;
            ListRefresher.RefreshRequested += OnRefreshRequested;
        }
        else
        {
            HistoryTracker.LocalBackHandler = TryCloseOverlayForBack;
        }
        _ = RefreshCodeStripPeriodicallyAsync(_codeExpiryCts.Token);
        // Back on the list after sending is a calm moment to (maybe) ask for a Play rating.
        await ReviewPrompt.MaybeAskAsync();
    }

    [CascadingParameter(Name = "TwoPane")]
    public bool TwoPane { get; set; }

    private long? _openThreadId;
    private bool _disposed;

    private void OnListLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _openThreadId = ForgeLinkSms.Core.Utils.TwoPaneRules.OpenThreadId(Nav.ToBaseRelativePath(e.Location));
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnRefreshRequested() => _ = InvokeAsync(async () =>
    {
        await ViewModel.ReloadCommand.ExecuteAsync(null);
        StateHasChanged();
    });

    // Raised from the SMS receiver's background thread, hence InvokeAsync.
    private void OnMessageReceived(long threadId)
    {
        _ = InvokeAsync(async () =>
        {
            await ViewModel.LoadCommand.ExecuteAsync(null);
            StateHasChanged();
        });
    }

    // Re-renders so the code strip's age label updates and the strip disappears once the code expires.
    private async Task RefreshCodeStripPeriodicallyAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task CopyCode(ForgeLinkSms.Core.Models.OneTimeCode code)
    {
        await Clipboard.Default.SetTextAsync(code.Code);
        _copiedCode = code;
    }

    private void DismissCode(ForgeLinkSms.Core.Models.OneTimeCode code) => ViewModel.DismissCode(code);

    private static string FormatCodeAge(DateTimeOffset receivedAt)
    {
        var minutes = (int)(DateTimeOffset.Now - receivedAt).TotalMinutes;
        return minutes < 1 ? "just now" : $"{minutes} min ago";
    }

    // The hardware back button is fully intercepted at the native layer (see MainActivity) to fix
    // an unrelated bug, so it no longer reaches this page's own click handlers or the filter
    // sheet's own click-outside-to-close handler — it must close the sheet or clear an active
    // multi-select itself instead of falling through to exiting the app.
    private bool TryCloseOverlayForBack()
    {
        if (_reportThread is not null)
        {
            _reportThread = null;
            StateHasChanged();
            return true;
        }

        if (_snoozeThreadId is not null)
        {
            CloseSnoozeSheet();
            StateHasChanged();
            return true;
        }

        if (_filterSheet is { IsOpen: true })
        {
            _filterSheet.Close();
            return true;
        }

        if (_selectedThreadIds.Count == 0)
        {
            return false;
        }

        ClearSelection();
        StateHasChanged();
        return true;
    }

    private void OnAppResumed()
    {
        // A pointerdown on a row can be left "stuck" with no matching pointerup if this
        // activity loses foreground focus mid-gesture — e.g. the "+" avatar button launching
        // the native Add Contact screen. Without this reset, the next unrelated tap/scroll to
        // land on that same row would compute its swipe distance against the stale pointerdown
        // position and could be misread as a real swipe, incorrectly trashing or archiving it.
        _activePointerDownThreadId = null;
        _longPressCts?.Cancel();
        _longPressTriggered = false;

        _ = InvokeAsync(async () =>
        {
            await ViewModel.LoadCommand.ExecuteAsync(null);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        AppResumeNotifier.Resumed -= OnAppResumed;
        IncomingMessageNotifier.MessageReceived -= OnMessageReceived;
        Nav.LocationChanged -= OnListLocationChanged;
        ListRefresher.RefreshRequested -= OnRefreshRequested;

        // Fire-and-forget: the WebView may already be tearing down, and a leftover listener only
        // looks up elements that no longer exist.
        _ = JS.InvokeVoidAsync("forgeLinkBubblePond.dispose").AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
        _undoToastCts?.Cancel();
        _codeExpiryCts.Cancel();

        // Blazor's router can create the next page before disposing this one, so only clear the
        // handler if it's still ours — otherwise this would wipe out a registration the next page
        // already made.
        if (HistoryTracker.LocalBackHandler == TryCloseOverlayForBack)
        {
            HistoryTracker.LocalBackHandler = null;
        }
        if (HistoryTracker.PaneBackHandler == TryCloseOverlayForBack)
        {
            HistoryTracker.PaneBackHandler = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("forgeLinkBubblePond.observe", "bubble-pond", "bubble-pond-mini", "conversations-header,lane-tabs");
        }
        if (_restoreRowAnchor)
        {
            _restoreRowAnchor = false;
            await JS.InvokeVoidAsync("forgeLinkBubblePond.restoreRow");
        }
        if (_scrollPinnedToTop && _pinnedThreadId is { } pinnedId)
        {
            _scrollPinnedToTop = false;
            await JS.InvokeVoidAsync("forgeLinkBubblePond.scrollListToTop", RowId(pinnedId));
        }
        if (_shouldFocusSearch)
        {
            _shouldFocusSearch = false;
            await _searchInput.FocusAsync();
        }
    }

