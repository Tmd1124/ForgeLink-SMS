        UpdateCategory.Codes => "🔑",
        UpdateCategory.Appointments => "📅",
        UpdateCategory.Deliveries => "📦",
        UpdateCategory.Banking => "💳",
        UpdateCategory.Promotions => "🏷️",
        _ => "📨"
    };

    private static string CategoryName(UpdateCategory category) => category switch
