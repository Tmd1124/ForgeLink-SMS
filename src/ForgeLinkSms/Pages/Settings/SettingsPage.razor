@page "/settings"
@implements IDisposable
@inject ForgeLinkSms.Core.ViewModels.SettingsViewModel ViewModel
@inject ForgeLinkSms.Core.Services.IDisplayStyleService DisplayStyles
@inject ForgeLinkSms.Core.Services.INotificationSettingsStore NotificationStore
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ForgeLinkSms.Core.Services.IBackupService Backups
@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Utils

<div style="padding:12px;padding-bottom:40px;">
    <h3>Settings</h3>
    <p>Default SMS app: @(ViewModel.IsDefaultSmsApp ? "Yes ✓" : "No — open Onboarding to fix this")</p>

    <h4 style="margin:24px 0 4px;">Notifications</h4>
    <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;font-weight:600;">
        <input type="checkbox" checked="@_notify.Enabled" @onchange="e => UpdateNotify(n => n.Enabled = e.Value is true)" style="width:20px;height:20px;" />
        Notify me about new texts
    </label>
    @if (_notify.Enabled)
    {
        <div style="@HintStyle">Choose who can notify you, and whether it makes a sound. Muted conversations never notify.</div>
        <div style="display:grid;grid-template-columns:1fr 64px 64px;align-items:center;row-gap:4px;margin-top:8px;">
            <span></span>
            <span style="@HintStyle;text-align:center;">Notify</span>
            <span style="@HintStyle;text-align:center;">Sound</span>
            @foreach (var (group, icon, title, hint) in NotifyGroups)
            {
                var setting = _notify.For(group);
                <div style="padding:8px 4px;">
                    <div style="font-weight:600;">@icon @title</div>
                    <div style="@HintStyle">@hint</div>
                </div>
                <input type="checkbox" checked="@setting.Notify" aria-label="@($"Notify for {title}")"
                       @onchange="e => UpdateNotify(n => n.Set(group, new GroupNotifySetting(e.Value is true, e.Value is true)))"
                       style="width:22px;height:22px;justify-self:center;" />
                <input type="checkbox" checked="@setting.Sound" disabled="@(!setting.Notify)" aria-label="@($"Sound for {title}")"
                       @onchange="e => UpdateNotify(n => n.Set(group, setting with { Sound = e.Value is true }))"
                       style="width:22px;height:22px;justify-self:center;opacity:@(setting.Notify ? "1" : "0.35");" />
            }
        </div>

        <div style="font-weight:600;margin:16px 0 6px;">Quick picks</div>
        <div style="display:flex;flex-direction:column;gap:6px;">
            <button @onclick="() => ApplyNotify(NotificationRules.Everything)" style="@PresetStyle">🔔 Everything</button>
            <button @onclick="() => ApplyNotify(NotificationRules.FavoritesOnly)" style="@PresetStyle">❤️ Favorites only</button>
            <button @onclick="() => ApplyNotify(NotificationRules.EverythingSilent)" style="@PresetStyle">🔕 Everything, no sound</button>
        </div>

        <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;margin-top:8px;">
            <input type="checkbox" checked="@_notify.AlwaysAlertForCodes" @onchange="e => UpdateNotify(n => n.AlwaysAlertForCodes = e.Value is true)" style="width:20px;height:20px;" />
            🔑 Always alert me for verification codes, even from Updates or Screener
        </label>

        <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;">
            <input type="checkbox" checked="@_notify.QuietHoursEnabled" @onchange="e => UpdateNotify(n => n.QuietHoursEnabled = e.Value is true)" style="width:20px;height:20px;" />
            🌙 Quiet hours: notifications arrive without sound
        </label>
        @if (_notify.QuietHoursEnabled)
        {
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:0 4px 8px 34px;">
                <label>From <input type="time" value="@_notify.QuietStart.ToString("HH:mm")" @onchange="e => SetQuietTime(e, start: true)" style="font:inherit;" /></label>
                <label>to <input type="time" value="@_notify.QuietEnd.ToString("HH:mm")" @onchange="e => SetQuietTime(e, start: false)" style="font:inherit;" /></label>
            </div>
            <label style="display:flex;align-items:center;gap:10px;padding:4px 4px 10px 34px;">
                <input type="checkbox" checked="@_notify.FavoritesRingDuringQuietHours" @onchange="e => UpdateNotify(n => n.FavoritesRingDuringQuietHours = e.Value is true)" style="width:20px;height:20px;" />
                Let ❤️ favorites ring during quiet hours
            </label>
        }
    }

    <h4 style="margin:24px 0 4px;">Display</h4>
    <div style="@HintStyle">How your Chats list looks.</div>
    @foreach (var (layout, icon, title, description) in Layouts)
    {
        <div @onclick="() => ChooseLayout(layout)" style="@OptionStyle(_settings.Layout == layout)">
            <span style="font-size:1.6em;">@icon</span>
            <div style="flex:1;min-width:0;">
                <div style="font-weight:600;">@title</div>
                <div style="@HintStyle">@description</div>
            </div>
            <span style="@RadioStyle(_settings.Layout == layout)"></span>
        </div>
    }

    <div style="font-weight:600;margin:16px 0 6px;">Quick presets</div>
    <div style="display:flex;flex-direction:column;gap:6px;">
        <button @onclick="() => Apply(DisplayRules.BubblesOnlyFavoritesAndUnreadPreset)" style="@PresetStyle">🫧 Bubbles only: favorites + unread (no list)</button>
        <button @onclick="() => Apply(DisplayRules.FavoritesAndUnreadPreset)" style="@PresetStyle">🫧💬 Favorites + unread are bubbles</button>
        <button @onclick="() => Apply(DisplayRules.UnreadOnlyColorPreset)" style="@PresetStyle">💬 Only unread messages are colored</button>
        <button @onclick="() => Apply(DisplayRules.FavoritesWithFilterColorsPreset)" style="@PresetStyle">🏷️ Favorite bubbles + filter-colored list</button>
    </div>

    <h4 style="margin:24px 0 4px;">Filter tabs</h4>
    <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;">
        <input type="checkbox" checked="@_settings.ShowFilterTabs" @onchange="e => Update(s => s.ShowFilterTabs = e.Value is true)" style="width:20px;height:20px;" />
        Show filters that have conversations as tabs under Chats, Updates and Screener
    </label>

    <h4 style="margin:24px 0 4px;">Bubbles</h4>
    @if (_settings.Layout != ConversationDisplayStyle.Cards)
    {
        <div style="@HintStyle">@(_settings.Layout == ConversationDisplayStyle.Bubbles ? "Who gets a bubble. With no list, anyone else is only found through search and the tabs." : "Who gets a bubble. Everyone else is in the list.")</div>
        @foreach (var (label, isChecked, set) in BubbleChoices())
        {
            <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;">
                <input type="checkbox" checked="@isChecked" @onchange="e => Update(s => set(s, e.Value is true))" style="width:20px;height:20px;" />
                @label
            </label>
        }
    }
    else
    {
        <div style="@HintStyle">The Color list layout has no bubbles.</div>
    }

    <h4 style="margin:24px 0 4px;">Colored list</h4>
    <div style="@HintStyle">Color the list by</div>
    @foreach (var (mode, title) in ColorModes)
    {
        <div @onclick="() => Update(s => s.ColorBy = mode)" style="@OptionStyle(_settings.ColorBy == mode)">
            <div style="flex:1;">@title</div>
            <span style="@RadioStyle(_settings.ColorBy == mode)"></span>
        </div>
    }

    <div style="@HintStyle;margin-top:12px;">Unread messages</div>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;">
        @foreach (var (color, name) in UnreadColors)
        {
            var selected = _settings.UnreadColor == color;
            <div @onclick="() => Update(s => s.UnreadColor = color)" style="display:flex;flex-direction:column;align-items:center;gap:4px;width:56px;cursor:pointer;">
                <span style="width:40px;height:40px;border-radius:50%;box-sizing:border-box;background:@(color ?? "transparent");border:@(selected ? "3px solid var(--accent-color)" : color is null ? "2px dashed #94a3b8" : "3px solid transparent");display:flex;align-items:center;justify-content:center;color:#94a3b8;">@(color is null ? "∅" : "")</span>
                <span style="font-size:0.75em;text-align:center;">@name</span>
            </div>
        }
    </div>

    <h4 style="margin:24px 0 4px;">Text size</h4>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;">
        @foreach (var (scale, label) in TextSizes)
        {
            var selected = DisplayRules.TextScaleOrDefault(_settings.TextScale) == scale;
            <button @onclick="() => SetTextScale(scale)"
                    style="border:2px solid @(selected ? "var(--accent-color)" : "transparent");border-radius:12px;padding:10px 14px;background:var(--card-color);color:var(--text-color);font-size:@(scale / 100.0)em;font-weight:600;">@label</button>
        }
    </div>

    <h4 style="margin:24px 0 4px;">Privacy</h4>
    <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;">
        <input type="checkbox" checked="@_settings.ShowLinkPreviews" @onchange="e => Update(s => s.ShowLinkPreviews = e.Value is true)" style="width:20px;height:20px;" />
        <span>Show link previews<br /><span style="@HintStyle">To build a preview, ForgeLink opens the linked page — the only time the app uses the internet. Turn off and links stay plain.</span></span>
    </label>

    <h4 style="margin:24px 0 4px;">Backup</h4>
    <div style="@HintStyle">Saves all texts, photos and videos, plus favorites, filters, quick replies, scheduled texts and settings, to a file you choose. Restoring only adds what's missing — nothing is deleted.</div>
    <div style="margin:8px 4px;">
        @if (_backup.LastRunUtc is { } when)
        {
            <span>@(_backup.LastSucceeded == true ? "✅" : "⚠️") Last: @when.ToLocalTime().ToString("MMM d, h:mm tt") — @_backup.LastMessage</span>
        }
        else
        {
            <span style="@HintStyle">No backups yet.</span>
        }
        @if (_backup.IsRunning)
        {
            <div style="@HintStyle">A backup or restore is running — see the notification.</div>
        }
    </div>
    <div style="display:flex;flex-direction:column;gap:6px;">
        <button @onclick="BackUpNow" disabled="@_backup.IsRunning" style="@PresetStyle">💾 Back up now</button>
        <label style="display:flex;align-items:center;gap:10px;padding:10px 4px;">
            <input type="checkbox" checked="@_backup.WeeklyEnabled" @onchange="ToggleWeekly" style="width:20px;height:20px;" />
            <span>Back up automatically every week (while charging)@(_backup.WeeklyFolderName is { } f ? $" to {f}" : "")<br /><span style="@HintStyle">Keeps the newest 4 backups in that folder.</span></span>
        </label>
        <button @onclick="() => _passwordSheet = true" style="@PresetStyle">🔒 @(_backup.HasPassword ? "Change or remove backup password" : "Protect backups with a password")</button>
        <button @onclick="PickRestore" disabled="@_backup.IsRunning" style="@PresetStyle">♻️ Restore from a backup</button>
    </div>

    @if (_passwordSheet)
    {
        <div style="position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:flex-end;z-index:20;" @onclick="() => _passwordSheet = false">
            <div style="background:var(--card-color);width:100%;padding:16px;border-radius:16px 16px 0 0;" @onclick:stopPropagation="true">
                <div style="font-weight:600;">Backup password</div>
                <div style="@HintStyle;margin:6px 0 10px;">If you forget it, backups made with it can't be opened — there's no way to recover it.</div>
                <input type="password" @bind="_newPassword" placeholder="New password" style="width:100%;padding:10px;margin-bottom:8px;font:inherit;" />
                <input type="password" @bind="_confirmPassword" placeholder="Type it again" style="width:100%;padding:10px;font:inherit;" />
                @if (_passwordError is not null) { <div style="color:#b91c1c;margin-top:6px;">@_passwordError</div> }
                <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:12px;flex-wrap:wrap;">
                    @if (_backup.HasPassword) { <button @onclick="RemovePassword" style="@PresetStyle">Remove password</button> }
                    <button @onclick="SavePassword" style="@PresetStyle">Save</button>
                </div>
            </div>
        </div>
    }

    @if (_restoreFile is { } restoreFile)
    {
        <div style="position:fixed;inset:0;background:rgba(0,0,0,0.4);display:flex;align-items:flex-end;z-index:20;" @onclick="() => _restoreFile = null">
            <div style="background:var(--card-color);width:100%;padding:16px;border-radius:16px 16px 0 0;" @onclick:stopPropagation="true">
                <div style="font-weight:600;">Restore @restoreFile.FileName?</div>
                <div style="@HintStyle;margin:6px 0 10px;">Adds messages and ForgeLink data that aren't already on this phone. Nothing is deleted, and running it again is safe.</div>
                @if (restoreFile.IsEncrypted)
                {
                    <input type="password" @bind="_restorePassword" placeholder="Backup password" style="width:100%;padding:10px;font:inherit;" />
                }
                @if (_restoreError is not null)
                {
                    <div style="color:#b91c1c;margin-top:8px;">@_restoreError</div>
                }
                @if (_preview is { } preview)
                {
                    <div style="margin:10px 0;">
                        Backup from @preview.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt"): @preview.Messages.ToString("N0") messages, @preview.MediaFiles.ToString("N0") photos/videos.<br />
                        <strong>Restoring would add @preview.WouldAdd.ToString("N0") messages</strong> (@preview.AlreadyPresent.ToString("N0") are already on this phone).
                    </div>
                    <label style="display:flex;align-items:center;gap:10px;padding:10px 0;">
                        <input type="checkbox" @bind="_restoreSettings" style="width:20px;height:20px;" /> Also restore my settings
                    </label>
                    @if (preview.ScheduledTexts > 0)
                    {
                        <label style="display:flex;align-items:center;gap:10px;padding:10px 0;">
                            <input type="checkbox" @bind="_restoreScheduled" style="width:20px;height:20px;" />
                            Also re-add @preview.ScheduledTexts scheduled @(preview.ScheduledTexts == 1 ? "text" : "texts") (they will be sent at their scheduled times)
                        </label>
                    }
                }
                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button @onclick="() => _restoreFile = null" style="@PresetStyle">Cancel</button>
                    @if (_preview is null)
                    {
                        <button @onclick="CheckRestore" disabled="@(_checking || (restoreFile.IsEncrypted && string.IsNullOrEmpty(_restorePassword)))" style="@PresetStyle">@(_checking ? "Checking… (can take a minute)" : "Check backup")</button>
                    }
                    else
                    {
                        <button @onclick="StartRestore" style="@PresetStyle">Restore</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string HintStyle = "color:#94a3b8;font-size:0.85em";
    private const string PresetStyle = "text-align:left;border:none;border-radius:12px;padding:12px;background:var(--card-color);color:var(--text-color);font:inherit;font-weight:600;";

    private static readonly (ConversationDisplayStyle Layout, string Icon, string Title, string Description)[] Layouts =
    {
        (ConversationDisplayStyle.Bubbles, "🫧", "Bubbles", "Everyone is a bubble. Recent people are bigger and at the top."),
        (ConversationDisplayStyle.BubblesAndCards, "🫧💬", "Bubbles + color list", "The people you choose as bubbles, everyone else in a colorful list."),
        (ConversationDisplayStyle.Cards, "💬", "Color list", "Every conversation as a colorful message card.")
    };

    private static readonly (ListColorMode Mode, string Title)[] ColorModes =
    {
        (ListColorMode.Person, "Each person's own color"),
        (ListColorMode.Filter, "Filter colors (only conversations in a filter are colored)"),
        (ListColorMode.None, "No color")
    };

    private static readonly (string? Color, string Name)[] UnreadColors =
    {
        (DisplaySettings.Gray, "Gray"), ("#0ea5e9", "Blue"), ("#16a34a", "Green"), ("#f59e0b", "Yellow"),
        ("#e11d48", "Red"), ("#7c3aed", "Purple"), (null, "No color")
    };

    private static readonly (NotifyGroup Group, string Icon, string Title, string Hint)[] NotifyGroups =
    {
        (NotifyGroup.Favorites, "❤️", "Favorites", "People you've hearted"),
        (NotifyGroup.OtherChats, "💬", "Other chats", "Everyone else in Chats"),
        (NotifyGroup.Updates, "📦", "Updates", "Banks, deliveries, stores, alerts"),
        (NotifyGroup.Screener, "🛡️", "Screener", "Numbers you haven't talked with")
    };

    private static readonly (int Scale, string Label)[] TextSizes =
    {
        (90, "Small"), (100, "Default"), (115, "Large"), (130, "Extra large")
    };

    private DisplaySettings _settings = new();
    private NotificationSettings _notify = new();

    private static string OptionStyle(bool selected) =>
        $"display:flex;align-items:center;gap:12px;padding:12px;margin-bottom:8px;border-radius:14px;cursor:pointer;background:var(--card-color);border:2px solid {(selected ? "var(--accent-color)" : "transparent")};";

    private static string RadioStyle(bool selected) =>
        $"width:22px;height:22px;border-radius:50%;flex-shrink:0;border:2px solid var(--accent-color);background:{(selected ? "var(--accent-color)" : "transparent")};";

    private IEnumerable<(string Label, bool Checked, Action<DisplaySettings, bool> Set)> BubbleChoices()
    {
        yield return ("👥 Everyone", _settings.BubbleEveryone, (s, v) => s.BubbleEveryone = v);
        yield return ("❤️ Favorites", _settings.BubbleFavorites, (s, v) => s.BubbleFavorites = v);
        yield return ("🔵 Unread", _settings.BubbleUnread, (s, v) => s.BubbleUnread = v);
        yield return ("🕒 People you text most recently (top 8)", _settings.BubbleRecent, (s, v) => s.BubbleRecent = v);
        yield return ("🏷️ People assigned to a filter", _settings.BubbleFiltered, (s, v) => s.BubbleFiltered = v);
    }

    private ForgeLinkSms.Core.Services.BackupStatus _backup = new(null, null, null, false, null, false, false);
    private bool _passwordSheet;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _passwordError;
    private ForgeLinkSms.Core.Services.RestoreFile? _restoreFile;
    private string _restorePassword = string.Empty;
    private bool _restoreSettings;
    private bool _restoreScheduled;

    private readonly CancellationTokenSource _pageCts = new();
    private bool _polling;

    // Backups run in the background; while one is running, keep the status line and buttons current.
    private void RefreshBackup()
    {
        _backup = Backups.GetStatus();
        if (_backup.IsRunning && !_polling)
        {
            _ = PollBackupAsync();
        }
    }

    private async Task PollBackupAsync()
    {
        _polling = true;
        try
        {
            while (!_pageCts.IsCancellationRequested)
            {
                await Task.Delay(3000, _pageCts.Token);
                var status = await Task.Run(Backups.GetStatus);
                await InvokeAsync(() =>
                {
                    _backup = status;
                    StateHasChanged();
                });
                if (!status.IsRunning)
                {
                    break;
                }
            }
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            _polling = false;
        }
    }

    public void Dispose() => _pageCts.Cancel();

    private async Task BackUpNow()
    {
        await Backups.BackUpNowAsync();
        RefreshBackup();
    }

    private async Task ToggleWeekly(ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            await Backups.EnableWeeklyAsync();
        }
        else
        {
            Backups.DisableWeekly();
        }
        RefreshBackup();
    }

    private async Task SavePassword()
    {
        if (_newPassword.Length < 6)
        {
            _passwordError = "Use at least 6 characters.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _passwordError = "The two passwords don't match.";
            return;
        }
        await Backups.SetPasswordAsync(_newPassword);
        _newPassword = _confirmPassword = string.Empty;
        _passwordError = null;
        _passwordSheet = false;
        RefreshBackup();
    }

    private async Task RemovePassword()
    {
        await Backups.SetPasswordAsync(null);
        _passwordSheet = false;
        RefreshBackup();
    }

    private ForgeLinkSms.Core.Backup.RestorePreview? _preview;
    private bool _checking;
    private string? _restoreError;

    private async Task PickRestore()
    {
        _restorePassword = string.Empty;
        _restoreSettings = false;
        _restoreScheduled = false;
        _preview = null;
        _restoreError = null;
        _restoreFile = await Backups.PickRestoreFileAsync();
    }

    private async Task CheckRestore()
    {
        if (_restoreFile is not { } file)
        {
            return;
        }
        _checking = true;
        _restoreError = null;
        try
        {
            _preview = await Backups.PreviewRestoreAsync(file, file.IsEncrypted ? _restorePassword : null);
        }
        catch (ForgeLinkSms.Core.Backup.BackupException e)
        {
            _restoreError = e.Message;
        }
        catch (Exception e)
        {
            _restoreError = $"Couldn't read this backup: {e.Message}";
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task StartRestore()
    {
        if (_restoreFile is { } file)
        {
            await Backups.StartRestoreAsync(file, file.IsEncrypted ? _restorePassword : null, _restoreSettings, _restoreScheduled);
            _restoreFile = null;
            RefreshBackup();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _settings = DisplayStyles.GetDisplaySettings();
        _notify = NotificationStore.Get();
        await ViewModel.RefreshCommand.ExecuteAsync(null);
        RefreshBackup();
    }

    private void UpdateNotify(Action<NotificationSettings> change)
    {
        var updated = _notify.Clone();
        change(updated);
        _notify = updated;
        NotificationStore.Save(updated);
    }

    private void ApplyNotify(Func<NotificationSettings, NotificationSettings> preset)
    {
        _notify = preset(_notify);
        NotificationStore.Save(_notify);
    }

    private void SetQuietTime(ChangeEventArgs e, bool start)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var time))
        {
            UpdateNotify(n => { if (start) n.QuietStart = time; else n.QuietEnd = time; });
        }
    }

    private void Update(Action<DisplaySettings> change)
    {
        var updated = _settings.Clone();
        change(updated);
        _settings = updated;
        DisplayStyles.SaveDisplaySettings(updated);
    }

    private async Task SetTextScale(int scale)
    {
        Update(s => s.TextScale = scale);
        await JS.InvokeVoidAsync("applyTextScale", scale);
    }

    private void ChooseLayout(ConversationDisplayStyle layout) => Apply(s => DisplayRules.WithLayout(s, layout));

    private void Apply(Func<DisplaySettings, DisplaySettings> preset)
    {
        _settings = preset(_settings);
        DisplayStyles.SaveDisplaySettings(_settings);
    }
}
