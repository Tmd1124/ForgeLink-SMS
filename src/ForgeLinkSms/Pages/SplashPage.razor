@page "/"
@inject ForgeLinkSms.Core.ViewModels.SplashViewModel ViewModel
@inject ForgeLinkSms.Core.Services.PendingNavigationStore PendingNav
@inject ForgeLinkSms.Core.Services.IThemeService ThemeService
@inject ForgeLinkSms.Core.Services.IBootDetectionService BootDetection
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ForgeLinkSms.Core.Services.IDisplayStyleService DisplayStyles

@if (_showSplash)
{
    <div class="splash-screen">
        <div class="splash-glow"></div>
        <img src="images/splash-logo.jpg" class="splash-logo" alt="ForgeLink SMS" />
    </div>
}

<style>
    .splash-screen {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        width: 100vw;
        background: #000000;
        overflow: hidden;
    }

    .splash-glow {
        position: absolute;
        width: 60vw;
        height: 60vw;
        max-width: 340px;
        max-height: 340px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 149, 0, 0.35) 0%, rgba(60, 170, 255, 0.25) 45%, rgba(0, 0, 0, 0) 72%);
        transform: scale(0);
        animation: splash-flare 150ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .splash-logo {
        position: relative;
        width: 45vw;
        max-width: 260px;
        border-radius: 20%;
        filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.5));
        animation: splash-grow 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes splash-flare {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        35% {
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 0;
        }
    }

    @@keyframes splash-grow {
        0% {
            transform: scale(0.05) rotate(-8deg);
            opacity: 0;
        }

        55% {
            opacity: 1;
        }

        100% {
            transform: scale(5) rotate(0deg);
            opacity: 1;
        }
    }
</style>

@code {
    private bool _showSplash;

    protected override async Task OnInitializedAsync()
    {
        await JS.InvokeVoidAsync("applyTheme", ThemeService.GetThemeMode().ToString(), ThemeService.GetAccentColor());
        await JS.InvokeVoidAsync("applyTextScale", ForgeLinkSms.Core.Utils.DisplayRules.TextScaleOrDefault(DisplayStyles.GetDisplaySettings().TextScale));

        var pendingRoute = PendingNav.ConsumePendingRoute();
        if (!string.IsNullOrEmpty(pendingRoute))
        {
            Nav.NavigateTo(pendingRoute);
            return;
        }

        // The branded splash animation is only worth showing right after the device actually
        // restarts — every other cold start (e.g. Android killing the backgrounded app process
        // for memory, then the user switching back to it) should feel instant instead of
        // replaying a full-second animation the user has already seen this session.
        _showSplash = BootDetection.IsFirstLaunchSinceBoot();
        if (_showSplash)
        {
            await Task.Delay(1000);
        }

        await ViewModel.InitializeAsync();
    }
}
