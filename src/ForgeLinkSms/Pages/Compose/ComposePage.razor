@page "/compose"
@inject ForgeLinkSms.Core.Services.ForwardRequestStore Forwarding
@inject ForgeLinkSms.Core.ViewModels.ComposeViewModel ViewModel
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject ForgeLinkSms.Core.Services.NavigationHistoryTracker HistoryTracker
@inject ForgeLinkSms.Core.Data.IForwardedMessageRepository ForwardedMessages
@using ForgeLinkSms.Components
@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Utils

<style>
    .recipient-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--card-color);
        border-radius: 16px;
        padding: 3px 8px 3px 3px;
        margin: 2px 0;
    }

    .chip-avatar {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .chip-avatar-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--accent-color);
        color: white;
        font-size: 0.65em;
        font-weight: 600;
    }

    .chip-remove {
        cursor: pointer;
        color: #94a3b8;
        margin-left: 2px;
        position: relative;
    }

    /* An invisible 44px touch area around the small ✕, so it's easy to hit without changing the chip's look. */
    .chip-remove::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 44px;
        height: 44px;
        transform: translate(-50%, -50%);
    }

    .contact-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-bottom: 1px solid #eee;
    }

    .contact-row:active {
        background: var(--card-color);
    }

    .compose-grow-wrap {
        display: inline-grid;
        vertical-align: bottom;
    }
    .compose-grow-wrap::after {
        content: attr(data-replicated-value) " ";
        white-space: pre-wrap;
        visibility: hidden;
    }
    .compose-grow-wrap > textarea {
        resize: none;
        overflow-y: auto;
    }
    .compose-grow-wrap > textarea,
    .compose-grow-wrap::after {
        font: inherit;
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 16px;
        grid-area: 1 / 1 / 2 / 2;
        max-height: 150px;
        line-height: 1.3;
    }
</style>

<div style="display:flex;flex-direction:column;height:100vh;">
    <div style="padding:10px;background:var(--card-color);border-bottom:1px solid #eee;font-weight:600;">New Message</div>

    <div style="padding:6px 12px;border-bottom:1px solid #eee;display:flex;align-items:center;flex-wrap:wrap;gap:4px;">
        <span style="color:#94a3b8;font-size:0.9em;">To:</span>
        @foreach (var recipient in ViewModel.Recipients)
        {
            var contact = ViewModel.FindContact(recipient);
            <span class="recipient-chip">
                @if (!string.IsNullOrEmpty(contact?.PhotoUri))
                {
                    <img src="@contact.PhotoUri" class="chip-avatar" alt="" />
                }
                else
                {
                    <span class="chip-avatar chip-avatar-fallback">@(contact?.Initials ?? "#")</span>
                }
                @(contact?.DisplayName ?? PhoneNumberFormatter.ToDisplayFormat(recipient))
                <span class="chip-remove" @onclick="() => ViewModel.RemoveRecipientCommand.Execute(recipient)" role="button" tabindex="0" aria-label="Remove recipient">✕</span>
            </span>
        }
        <input placeholder="@(ViewModel.Recipients.Count == 0 ? "Name or phone number" : "Add another")"
               style="flex:1;min-width:100px;border:none;outline:none;background:transparent;font-size:1em;padding:6px 0;color:var(--text-color);"
               @bind="ViewModel.SearchText" @bind:event="oninput" @onkeyup="OnRecipientKeyUp" />
    </div>

    @if (ViewModel.IsGroupSend)
    {
        <div style="display:flex;gap:6px;padding:8px 12px 4px;">
            <button @onclick="() => ViewModel.SendAsGroup = true"
                    style="flex:1;border:none;border-radius:999px;padding:6px 0;font-weight:600;background:@(ViewModel.SendAsGroup ? "var(--accent-color)" : "#e2e8f0");color:@(ViewModel.SendAsGroup ? "white" : "#1e293b");">
                Group chat
            </button>
            <button @onclick="() => ViewModel.SendAsGroup = false"
                    style="flex:1;border:none;border-radius:999px;padding:6px 0;font-weight:600;background:@(ViewModel.SendAsGroup ? "#e2e8f0" : "var(--accent-color)");color:@(ViewModel.SendAsGroup ? "#1e293b" : "white");">
                Separate texts
            </button>
        </div>
        <p style="color:#94a3b8;padding:0 12px 8px;margin:0;font-size:0.85em;">
            @(ViewModel.SendAsGroup
                ? $"One group conversation with {ViewModel.Recipients.Count} people — everyone sees every reply."
                : $"Sending to {ViewModel.Recipients.Count} people individually — they won't see each other or each other's replies.")
        </p>
    }

    @if (ViewModel.IsMultiSelecting)
    {
        <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--card-color);border-bottom:1px solid #eee;">
            <span class="chip-remove" style="font-size:1.2em;" @onclick="() => ViewModel.CancelMultiSelectCommand.Execute(null)" role="button" tabindex="0" aria-label="Cancel">✕</span>
            <strong style="flex:1;">@ViewModel.SelectedCount selected</strong>
            <button style="border:none;background:var(--accent-color);color:white;border-radius:16px;padding:6px 14px;font-size:0.9em;"
                    @onclick="() => ViewModel.ConfirmMultiSelectCommand.Execute(null)">
                Add
            </button>
        </div>
    }

    @if (ShowContactList)
    {
        <div style="flex:1;overflow-y:auto;">
            @if (ViewModel.FilteredContacts.Count == 0)
            {
                <p style="text-align:center;color:#94a3b8;padding:24px 12px;">No matching contacts. Keep typing a full number to text it directly.</p>
            }
            else
            {
                @foreach (var contact in ViewModel.FilteredContacts)
                {
                    <div class="contact-row"
                         @onpointerdown="() => OnContactPointerDown(contact)"
                         @onpointerup="() => OnContactPointerUp(contact)"
                         @onpointerleave="CancelContactLongPress">
                        @if (ViewModel.IsMultiSelecting)
                        {
                            <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.3em;background:@(ViewModel.IsContactSelected(contact) ? "var(--accent-color)" : "transparent");border:2px solid var(--accent-color);color:white;">
                                @(ViewModel.IsContactSelected(contact) ? "✓" : "")
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(contact.PhotoUri))
                        {
                            <img src="@contact.PhotoUri" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                        }
                        else
                        {
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--accent-color);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0;">@contact.Initials</div>
                        }
                        <div>
                            <div>@contact.DisplayName</div>
                            <div style="font-size:0.8em;color:#94a3b8;">@PhoneNumberFormatter.ToDisplayFormat(contact.PhoneNumber)</div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div style="flex:1;"></div>
    }

    <PendingAttachmentPreview Attachment="_pendingAttachment" OnRemove="() => _pendingAttachment = null" />
    <ScheduledSendPreview Schedule="_scheduledSendTime" OnRemove="() => _scheduledSendTime = null" />
    <div style="display:flex;align-items:flex-end;padding:8px;border-top:1px solid #eee;">
        <button @onclick="() => _drawer?.Open()" aria-label="Attach"
                style="width:40px;height:40px;border-radius:50%;border:none;background:var(--card-color);color:var(--text-color);font-size:1.4em;margin-right:8px;flex-shrink:0;">
            +
        </button>
        <div class="compose-grow-wrap" data-replicated-value="@ViewModel.MessageBody" style="flex:1;">
            <textarea placeholder="Text message" rows="1" spellcheck="true" autocorrect="on" autocapitalize="sentences"
                      @bind="ViewModel.MessageBody" @bind:event="oninput"></textarea>
        </div>
        @if (ViewModel.Recipients.Count > 0 && (!string.IsNullOrWhiteSpace(ViewModel.MessageBody) || _pendingAttachment is not null))
        {
            <button @onclick="SendOrSchedule" aria-label="Send"
                    style="width:40px;height:40px;border-radius:50%;border:none;background:#22c55e;color:white;font-size:1.2em;margin-left:8px;flex-shrink:0;">
                ➤
            </button>
        }
    </div>
</div>

<AttachmentDrawer @ref="_drawer" OnInsertText="InsertIntoMessage" OnAttachmentPicked="a => _pendingAttachment = a" OnScheduleTimePicked="t => _scheduledSendTime = t" />

@code {
    [SupplyParameterFromQuery(Name = "add")]
    public string? AddParam { get; set; }

    private bool ShowContactList => ViewModel.IsMultiSelecting || ViewModel.Recipients.Count == 0 || !string.IsNullOrWhiteSpace(ViewModel.SearchText);

    private bool _longPressTriggered;
    private CancellationTokenSource? _longPressCts;
    private ForgeLinkSms.Components.AttachmentDrawer? _drawer;
    private ForgeLinkSms.Core.Models.PickedAttachment? _pendingAttachment;
    private ForgeLinkSms.Core.Models.ScheduledSend? _scheduledSendTime;
    private ForgeLinkSms.Core.Services.ForwardRequest? _forwardSource;

    private async Task SendOrSchedule()
    {
        if (_scheduledSendTime is { } sendAt)
        {
            await ViewModel.ScheduleSendCommand.ExecuteAsync(sendAt);
            _scheduledSendTime = null;
        }
        else
        {
            var attachment = _pendingAttachment;
            _pendingAttachment = null;
            await ViewModel.SendCommand.ExecuteAsync(attachment);
        }

        if (!ViewModel.LastSendSucceeded)
        {
            return;
        }
        if (_forwardSource is { SourceThreadId: { } sourceThreadId, SourceMessageKey: { } sourceKey })
        {
            var names = string.Join(", ", ViewModel.Recipients.Select(r => ViewModel.FindContact(r)?.DisplayName ?? PhoneNumberFormatter.ToDisplayFormat(r)));
            await ForwardedMessages.RecordAsync(sourceThreadId, sourceKey, names);
        }
        // A forward returns to the conversation it came from once it's on its way.
        if (_forwardSource?.ReturnRoute is { } returnRoute)
        {
            _forwardSource = null;
            if (!HistoryTracker.TryGoBack())
            {
                Nav.NavigateTo(returnRoute);
            }
        }
    }

    private void InsertIntoMessage(string text)
    {
        ViewModel.MessageBody = string.IsNullOrEmpty(ViewModel.MessageBody) ? text : $"{ViewModel.MessageBody}\n{text}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (Forwarding.Take() is { } forward)
        {
            ViewModel.MessageBody = forward.Text ?? string.Empty;
            _pendingAttachment = forward.Attachment;
            _forwardSource = forward;
        }
        await ViewModel.LoadContactsCommand.ExecuteAsync(null);
    }

    private void OnContactPointerDown(ContactInfo contact)
    {
        _longPressTriggered = false;
        _longPressCts = new CancellationTokenSource();
        var token = _longPressCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(500, token);
                _longPressTriggered = true;
                await InvokeAsync(() =>
                {
                    ViewModel.BeginMultiSelectCommand.Execute(contact);
                    StateHasChanged();
                });
            }
            catch (TaskCanceledException)
            {
                // pointer released or left before the long-press threshold — a normal tap, not a long-press
            }
        });
    }

    private void CancelContactLongPress() => _longPressCts?.Cancel();

    private void OnContactPointerUp(ContactInfo contact)
    {
        _longPressCts?.Cancel();
        if (_longPressTriggered)
        {
            return;
        }

        if (ViewModel.IsMultiSelecting)
        {
            ViewModel.ToggleContactSelectionCommand.Execute(contact);
        }
        else
        {
            ViewModel.SelectContactCommand.Execute(contact);
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(AddParam))
        {
            ViewModel.AddRecipientCommand.Execute(AddParam);
        }
    }

    private void OnRecipientKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(ViewModel.SearchText))
        {
            ViewModel.AddRecipientCommand.Execute(ViewModel.SearchText);
            ViewModel.SearchText = string.Empty;
        }
    }
}
