@page "/rate"
@inject ForgeLinkSms.Core.Services.ICrashReportService Email
@inject ForgeLinkSms.Core.Services.IRatingService Rating
@using ForgeLinkSms.Components.Help
@using ForgeLinkSms.Core.Help
@using ForgeLinkSms.Core.Services

<div class="rate-page">
    <div class="page-title-row">
        <h3>Rate ForgeLink</h3>
        <HelpButton />
    </div>

    <div class="rate-card">
        <div class="rate-glow" aria-hidden="true"></div>
        @if (_done is { } done)
        {
            <p class="rate-question" role="status">@(done == RatingSendResult.AlreadySent ? "You've already rated ForgeLink." : "Thank you!")</p>
            <p class="rate-note">@(done == RatingSendResult.AlreadySent
                ? "Your rating is already with us, so there's nothing more to send."
                : "Your rating was sent. It appears on cloudcompassai.com once we've read it.")</p>
        }
        else
        {
            <p class="rate-question">How is ForgeLink working for you?</p>
            <div class="rate-stars" role="radiogroup" aria-label="Rating">
                @for (var i = 1; i <= 5; i++)
                {
                    var star = i;
                    var on = star <= _stars;
                    <button class="rate-star @(on ? "on" : "")" role="radio" aria-checked="@(star == _stars ? "true" : "false")"
                            aria-label="@star star@(star == 1 ? "" : "s")" @onclick="() => _stars = star"
                            style="animation-delay:@((star - 1) * 45)ms;">
                        <svg width="44" height="44" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3 6.4 20.2l1.1-6.2L3 9.6l6.2-.9z" />
                        </svg>
                    </button>
                }
            </div>
            <div class="rate-label">@(_stars == 0 ? "Tap a star" : Labels[_stars - 1])</div>

            <textarea class="rate-comment" @bind="_comment" @bind:event="oninput" rows="4" maxlength="1500" placeholder="Tell us more (optional)" aria-label="Tell us more"></textarea>
            <input class="rate-name" @bind="_name" @bind:event="oninput" maxlength="40" placeholder="Name to show (optional)" aria-label="Name to show" autocomplete="off" />

            @if (_error is not null)
            {
                <p class="rate-error" role="alert">@_error</p>
            }

            <button class="rate-send" disabled="@(_stars == 0 || _sending)" @onclick="Send">@(_sending ? "Sending…" : "Send rating")</button>
            @if (_error is not null)
            {
                <button class="rate-alt" @onclick="SendByEmail">Send by email instead</button>
            }
            <p class="rate-note">Your rating and message may be shown on cloudcompassai.com. We don't send your phone number, messages or contacts.</p>
        }
    </div>
</div>

@code {
    private static readonly string[] Labels = { "Not good", "Could be better", "It's okay", "Really good", "Love it!" };

    [SupplyParameterFromQuery(Name = "stars")]
    public int? StarsFromLink { get; set; }

    private int _stars;
    private string _comment = string.Empty;
    private string _name = string.Empty;
    private string? _error;
    private bool _sending;
    private RatingSendResult? _done;

    protected override void OnParametersSet()
    {
        if (_stars == 0 && StarsFromLink is >= 1 and <= 5)
        {
            _stars = StarsFromLink.Value;
        }
    }

    private async Task Send()
    {
        if (_stars == 0 || _sending)
        {
            return;
        }
        _sending = true;
        _error = null;
        try
        {
            var outcome = await Rating.SendAsync(_stars, _comment, _name);
            if (outcome.Result == RatingSendResult.Failed)
            {
                _error = outcome.Message;
            }
            else
            {
                _done = outcome.Result;
            }
        }
        finally
        {
            _sending = false;
        }
    }

    private void SendByEmail() => Email.EmailRating(_stars, _comment);
}
