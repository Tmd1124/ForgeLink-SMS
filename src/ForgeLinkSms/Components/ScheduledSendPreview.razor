@if (Schedule is { } schedule)
{
    <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--card-color);border-top:1px solid #eee;">
        <div style="width:44px;height:44px;border-radius:8px;background:var(--surface-color);display:flex;align-items:center;justify-content:center;font-size:1.3em;flex-shrink:0;">⏰</div>
        <div style="flex:1;min-width:0;">
            <div style="font-size:0.85em;">@(schedule.Repeat == ForgeLinkSms.Core.Models.ScheduleRepeat.None ? "Will send" : ForgeLinkSms.Core.Utils.ScheduleRepeatRules.Label(schedule.Repeat) + " · first") @schedule.SendAtUtc.LocalDateTime.ToString("MMM d, h:mm tt")</div>
        </div>
        <span style="display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;cursor:pointer;color:#94a3b8;font-size:1.1em;" @onclick="Remove" role="button" tabindex="0" aria-label="Don't schedule">✕</span>
    </div>
}

@code {
    [Parameter]
    public ForgeLinkSms.Core.Models.ScheduledSend? Schedule { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private Task Remove() => OnRemove.InvokeAsync();
}
