@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Utils

@if (Attachment is not null)
{
    <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--card-color);border-top:1px solid #eee;">
        @if (_dataUri is not null)
        {
            <img src="@_dataUri" alt="Attached photo" style="width:44px;height:44px;border-radius:8px;object-fit:cover;flex-shrink:0;" />
        }
        else
        {
            <div style="width:44px;height:44px;border-radius:8px;background:var(--surface-color);display:flex;align-items:center;justify-content:center;font-size:1.3em;flex-shrink:0;">
                @(Attachment.Kind switch
                {
                    AttachmentKind.Video => "🎬",
                    AttachmentKind.Contact => "👤",
                    _ => "📄"
                })
            </div>
        }
        <div style="flex:1;min-width:0;">
            <div style="font-size:0.85em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@Attachment.FileName</div>
        </div>
        <span style="display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;cursor:pointer;color:#94a3b8;font-size:1.1em;" @onclick="Remove" role="button" tabindex="0" aria-label="Remove attachment">✕</span>
    </div>
}

@code {
    private string? _dataUri;
    private PickedAttachment? _lastRendered;

    [Parameter]
    public PickedAttachment? Attachment { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (Attachment == _lastRendered)
        {
            return;
        }

        _lastRendered = Attachment;
        _dataUri = Attachment is { Kind: AttachmentKind.Image or AttachmentKind.Gif }
            ? await ImageDataUriHelper.ToDataUriAsync(Attachment.LocalPath)
            : null;
    }

    private Task Remove() => OnRemove.InvokeAsync();
}
