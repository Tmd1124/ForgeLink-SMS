@inject ForgeLinkSms.Core.Services.IContactService ContactService
@inject ForgeLinkSms.Core.Services.ILocationService LocationService
@inject ForgeLinkSms.Core.Services.IAttachmentPickerService AttachmentPickerService
@inject ForgeLinkSms.Core.ViewModels.QuickRepliesViewModel QuickReplies
@using ForgeLinkSms.Core.Models
@using ForgeLinkSms.Core.Utils

<style>
    .drawer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        /* Stops above the compose bar (text box + send button) instead of covering it, so the
           compose bar stays visible and usable while the drawer is open. */
        bottom: 64px;
        background: rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: flex-end;
        z-index: 20;
    }

    .drawer-sheet {
        background: var(--card-color);
        width: 100%;
        padding: 16px;
        border-radius: 16px 16px 0 0;
        max-height: 60vh;
        overflow-y: auto;
    }

    .drawer-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .drawer-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        font-size: 0.8em;
        color: var(--text-color);
        cursor: pointer;
    }

    .drawer-item .icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--surface-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4em;
    }

    .drawer-item.disabled {
        opacity: 0.45;
    }

    .drawer-back {
        cursor: pointer;
        padding-bottom: 10px;
        color: var(--accent-color);
        font-weight: 600;
    }

    .drawer-contact-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    .quick-reply-row {
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid #eee;
    }

    .quick-reply-row .text {
        flex: 1;
        min-width: 0;
        padding: 12px 0;
        cursor: pointer;
    }

    .quick-reply-row button,
    .quick-reply-add button {
        border: none;
        background: transparent;
        color: var(--text-color);
        font-size: 1.1em;
        padding: 6px;
        flex-shrink: 0;
    }

    .quick-reply-add {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .quick-reply-add input,
    .quick-reply-row input {
        flex: 1;
        min-width: 0;
        padding: 8px 10px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        font-size: 1em;
        background: var(--surface-color);
        color: var(--text-color);
    }

    .drawer-toast {
        position: fixed;
        left: 50%;
        bottom: 90px;
        transform: translateX(-50%);
        background: #111827;
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85em;
        z-index: 30;
    }
</style>

@if (_isOpen)
{
    <div class="drawer-overlay" @onclick="Close">
        <div class="drawer-sheet" role="dialog" aria-modal="true" aria-label="Attach" @onclick:stopPropagation="true">
            @if (_mode == DrawerMode.Grid)
            {
                <div class="drawer-grid">
                    <div class="drawer-item" @onclick="PickGallery" role="button" tabindex="0">
                        <span class="icon">🖼️</span>
                        <span>Gallery</span>
                    </div>
                    <div class="drawer-item" @onclick="PickGif" role="button" tabindex="0">
                        <span class="icon">🎬</span>
                        <span>GIFs</span>
                    </div>
                    <div class="drawer-item" @onclick="PickFile" role="button" tabindex="0">
                        <span class="icon">📁</span>
                        <span>Files</span>
                    </div>
                    <div class="drawer-item" @onclick="ShareLocation" role="button" tabindex="0">
                        <span class="icon">📍</span>
                        <span>Location</span>
                    </div>
                    <div class="drawer-item" @onclick="OpenContactPicker" role="button" tabindex="0">
                        <span class="icon">👤</span>
                        <span>Contact</span>
                    </div>
                    <div class="drawer-item" @onclick="OpenSchedulePicker" role="button" tabindex="0">
                        <span class="icon">⏰</span>
                        <span>Schedule</span>
                    </div>
                    <div class="drawer-item" @onclick="OpenQuickReplies" role="button" tabindex="0">
                        <span class="icon">💬</span>
                        <span>Quick replies</span>
                    </div>
                </div>
            }
            else if (_mode == DrawerMode.QuickReplies)
            {
                <div class="drawer-back" @onclick="() => _mode = DrawerMode.Grid" role="button" tabindex="0">‹ Back</div>
                @if (QuickReplies.Replies.Count == 0)
                {
                    <p style="color:#94a3b8;margin:0;">No quick replies yet. Add one below.</p>
                }
                @foreach (var reply in QuickReplies.Replies)
                {
                    <div class="quick-reply-row">
                        @if (_editingReplyId == reply.Id)
                        {
                            <input @bind="_editingReplyText" @bind:event="oninput" />
                            <button @onclick="SaveEditedReply" title="Save" aria-label="Save">✓</button>
                            <button @onclick="() => _editingReplyId = null" title="Cancel" aria-label="Cancel">✕</button>
                        }
                        else
                        {
                            <div class="text" @onclick="() => InsertQuickReply(reply.Text)" role="button" tabindex="0">@reply.Text</div>
                            <button @onclick="() => StartEditingReply(reply)" title="Edit" aria-label="Edit">✏️</button>
                            <button @onclick="() => QuickReplies.DeleteCommand.ExecuteAsync(reply.Id)" title="Delete" aria-label="Delete">🗑</button>
                        }
                    </div>
                }
                <div class="quick-reply-add">
                    <input placeholder="Add a quick reply" @bind="_newReplyText" @bind:event="oninput" />
                    <button @onclick="AddQuickReply" disabled="@string.IsNullOrWhiteSpace(_newReplyText)" title="Add" aria-label="Add">➕</button>
                </div>
            }
            else if (_mode == DrawerMode.ContactList)
            {
                <div class="drawer-back" @onclick="() => _mode = DrawerMode.Grid" role="button" tabindex="0">‹ Back</div>
                @if (_contacts is { Count: 0 })
                {
                    <p style="text-align:center;color:#94a3b8;">No contacts found.</p>
                }
                else
                {
                    @foreach (var contact in _contacts ?? Enumerable.Empty<ContactInfo>())
                    {
                        <div class="drawer-contact-row" @onclick="() => ShareContact(contact)" role="button" tabindex="0">
                            @if (!string.IsNullOrEmpty(contact.PhotoUri))
                            {
                                <img src="@contact.PhotoUri" alt="" style="width:36px;height:36px;border-radius:50%;object-fit:cover;flex-shrink:0;" />
                            }
                            else
                            {
                                <div style="width:36px;height:36px;border-radius:50%;background:var(--accent-color);color:white;display:flex;align-items:center;justify-content:center;flex-shrink:0;">@contact.Initials</div>
                            }
                            <div>
                                <div>@contact.DisplayName</div>
                                <div style="font-size:0.8em;color:#94a3b8;">@PhoneNumberFormatter.ToDisplayFormat(contact.PhoneNumber)</div>
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="drawer-back" @onclick="() => _mode = DrawerMode.Grid" role="button" tabindex="0">‹ Back</div>
                <p style="margin:0 0 12px;">When should this be sent?</p>
                <input type="datetime-local" @bind="_scheduleInputValue" min="@_minScheduleValue.ToString("yyyy-MM-ddTHH:mm")"
                       style="width:100%;padding:10px;border-radius:8px;border:1px solid #cbd5e1;font-size:1em;box-sizing:border-box;" />
                <label style="display:block;margin:12px 0 6px;">Repeat</label>
                <select @bind="_scheduleRepeat"
                        style="width:100%;padding:10px;border-radius:8px;border:1px solid #cbd5e1;font-size:1em;box-sizing:border-box;background:var(--card-color);color:inherit;">
                    @foreach (var repeat in ForgeLinkSms.Core.Utils.ScheduleRepeatRules.All)
                    {
                        <option value="@repeat">@ForgeLinkSms.Core.Utils.ScheduleRepeatRules.Label(repeat)</option>
                    }
                </select>
                <button @onclick="ConfirmSchedule" disabled="@(_scheduleInputValue is null)"
                        style="width:100%;margin-top:12px;padding:10px;border-radius:8px;border:none;background:var(--accent-color);color:white;font-size:1em;">
                    Confirm
                </button>
            }
        </div>
    </div>
}

@if (_toastMessage is not null)
{
    <div class="drawer-toast" role="alert">@_toastMessage</div>
}

@code {
    private enum DrawerMode { Grid, ContactList, Schedule, QuickReplies }

    private bool _isOpen;
    private DrawerMode _mode = DrawerMode.Grid;

    public bool IsOpen => _isOpen;
    private string? _toastMessage;
    private List<ContactInfo>? _contacts;
    private CancellationTokenSource? _toastCts;
    private DateTime? _scheduleInputValue;
    private ForgeLinkSms.Core.Models.ScheduleRepeat _scheduleRepeat;
    private DateTime _minScheduleValue;
    private long? _editingReplyId;
    private string _editingReplyText = string.Empty;
    private string _newReplyText = string.Empty;

    [Parameter]
    public EventCallback<string> OnInsertText { get; set; }

    [Parameter]
    public EventCallback<PickedAttachment> OnAttachmentPicked { get; set; }

    [Parameter]
    public EventCallback<ForgeLinkSms.Core.Models.ScheduledSend> OnScheduleTimePicked { get; set; }

    public void Open()
    {
        _isOpen = true;
        _mode = DrawerMode.Grid;
        StateHasChanged();
    }

    public void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    private async Task OpenContactPicker()
    {
        _contacts ??= (await ContactService.GetAllContactsAsync()).ToList();
        _mode = DrawerMode.ContactList;
    }

    private async Task ShareLocation()
    {
        var location = await LocationService.GetCurrentLocationAsync();
        if (location is null)
        {
            await ShowToast("Couldn't get your location");
            return;
        }

        Close();
        await OnInsertText.InvokeAsync(AttachmentTextFormatter.FormatLocationLink(location.Value.Latitude, location.Value.Longitude));
    }

    private async Task ShareContact(ContactInfo contact)
    {
        Close();

        var attachmentsDir = Path.Combine(FileSystem.AppDataDirectory, "attachments");
        Directory.CreateDirectory(attachmentsDir);

        var fileName = $"{SanitizeFileName(contact.DisplayName)}.vcf";
        var localPath = Path.Combine(attachmentsDir, fileName);
        await File.WriteAllTextAsync(localPath, AttachmentTextFormatter.FormatContactShare(contact));

        await OnAttachmentPicked.InvokeAsync(new PickedAttachment
        {
            FileName = fileName,
            LocalPath = localPath,
            Kind = AttachmentKind.Contact
        });
    }

    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(name.Select(c => invalid.Contains(c) ? '_' : c).ToArray());
        return cleaned.Length == 0 ? "Contact" : cleaned;
    }

    private Task PickGallery() => PickAndShare(AttachmentPickerService.PickImageOrVideoAsync);

    private Task PickGif() => PickAndShare(AttachmentPickerService.PickGifAsync);

    private Task PickFile() => PickAndShare(AttachmentPickerService.PickFileAsync);

    private async Task PickAndShare(Func<Task<PickedAttachment?>> pick)
    {
        var attachment = await pick();
        if (attachment is null)
        {
            return;
        }

        Close();
        await OnAttachmentPicked.InvokeAsync(attachment);
    }

    private async Task OpenQuickReplies()
    {
        _editingReplyId = null;
        _newReplyText = string.Empty;
        await QuickReplies.LoadCommand.ExecuteAsync(null);
        _mode = DrawerMode.QuickReplies;
    }

    private async Task InsertQuickReply(string text)
    {
        Close();
        await OnInsertText.InvokeAsync(text);
    }

    private void StartEditingReply(QuickReply reply)
    {
        _editingReplyId = reply.Id;
        _editingReplyText = reply.Text;
    }

    private async Task SaveEditedReply()
    {
        if (_editingReplyId is long id)
        {
            await QuickReplies.UpdateCommand.ExecuteAsync((id, _editingReplyText));
        }
        _editingReplyId = null;
    }

    private async Task AddQuickReply()
    {
        await QuickReplies.AddCommand.ExecuteAsync(_newReplyText);
        _newReplyText = string.Empty;
    }

    private void OpenSchedulePicker()
    {
        var now = DateTime.Now;
        _minScheduleValue = now;
        _scheduleInputValue = new DateTime(now.Year, now.Month, now.Day, now.Hour, 0, 0).AddHours(1);
        _scheduleRepeat = ForgeLinkSms.Core.Models.ScheduleRepeat.None;
        _mode = DrawerMode.Schedule;
    }

    private async Task ConfirmSchedule()
    {
        if (_scheduleInputValue is not { } localTime)
        {
            return;
        }

        var sendAt = new DateTimeOffset(DateTime.SpecifyKind(localTime, DateTimeKind.Local));
        Close();
        await OnScheduleTimePicked.InvokeAsync(new ForgeLinkSms.Core.Models.ScheduledSend(sendAt, _scheduleRepeat));
    }

    private Task ShowComingSoon() => ShowToast("Coming soon");

    private async Task ShowToast(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _toastMessage = message;
        StateHasChanged();

        try
        {
            await Task.Delay(1800, token);
            _toastMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer toast
        }
    }
}
